      <stop offset=".73" stop-color="#ad9275" stop-opacity=".48"/>
      <stop offset="1" stop-color="#ad9275" stop-opacity="0"/>
    </linearGradient>
    <mask id="giza-middle-mask" maskUnits="userSpaceOnUse" x="145" y="42" width="510" height="177">
