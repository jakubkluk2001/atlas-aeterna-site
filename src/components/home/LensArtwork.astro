    <path d="M147 125C193 110 222 76 274 64C315 54 326 91 367 102C413 114 454 61 508 57C562 52 581 86 653 75" stroke-width="1.65"/>
    <path d="M152 129C195 116 229 84 274 75C312 67 326 99 367 110C412 123 450 74 507 68C560 63 586 94 648 80" stroke-width="1.05" opacity=".63"/>
    <path d="M174 128C215 115 247 91 277 87C313 80 329 111 367 119C416 130 449 87 504 80C551 73 584 97 627 91" stroke-width=".95" opacity=".39"/>
    <path d="M147 150C208 153 252 114 299 116C344 119 353 143 394 146C448 150 462 117 510 107C554 98 599 119 654 102" stroke-width="1.39" opacity=".73"/>
