  <path d="M238 78q-1 16 4 23m6-27q-1 15 4 23m9-28q-1 14 3 24m16-28q-2 15 3 27m13-25q-2 12 4 25m10-19q-1 11 5 23m12-16q-1 12 6 25m11-16q1 12 6 24m11-17q1 15 6 23m12-18q1 14 6 24m12-25q1 13 6 21m10-24q1 13 6 22m11-28q1 14 7 21m10-33q1 15 7 22m10-33q2 17 8 21m12-31q2 14 7 21m12-27q2 15 7 23m13-25q1 14 6 24m14-25q2 14 7 25m11-23q2 16 7 24m12-20q1 11 5 19m13-14q1 10 5 19m14-14q3 10 7 17" fill="none" stroke="#4e9e96" stroke-width=".72" opacity=".23"/>

  <path d="M145 208L182 202L213 192L238 197L278 179L294 185L314 171L331 176L357 162L384 182L409 175L429 182L466 154L489 166L519 160L547 182L565 176L591 194L626 196L655 206V215H145Z" fill="url(#aurora-ridge)"/>
  <path d="M145 208L182 202L213 192L238 197L278 179L294 185L314 171L331 176L357 162L384 182L409 175L429 182L466 154L489 166L519 160L547 182L565 176L591 194L626 196L655 206M271 198L294 194L314 171L307 190M337 188L357 162L359 178L373 187M429 195L466 154L463 174L476 188M516 184L519 160L527 176L541 184" fill="none" stroke="url(#aurora-ridge-line)" stroke-width="1.34"/>
  <path d="M161 214c67-3 111-8 163-10 64-2 90 5 140 3 52-3 77-6 113-3 22 2 43 5 64 8" fill="none" stroke="url(#aurora-ridge-line)" stroke-width="1" opacity=".43"/>
</g>
  <g class="artwork artwork--mysteries">
    <image href={mysteryArtwork} width="800" height="280" />
  </g>
  <defs>
    <linearGradient id="atlas-quiet-ink" gradientUnits="userSpaceOnUse" x1="100" x2="700">
      <stop stop-color="#627db0" stop-opacity="0"/>
      <stop offset=".26" stop-color="#6c82b6" stop-opacity=".38"/>
      <stop offset=".54" stop-color="#6a72af" stop-opacity=".49"/>
      <stop offset=".78" stop-color="#6d72b1" stop-opacity=".36"/>
      <stop offset="1" stop-color="#777eba" stop-opacity="0"/>
    </linearGradient>
  </defs>
</svg>

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  .artwork {
    opacity: 0;
    transition: opacity 330ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global([data-feature="idle"]) .artwork--idle,
  :global([data-feature="history"]) .artwork--history,
  :global([data-feature="geography"]) .artwork--geography,
  :global([data-feature="mysteries"]) .artwork--mysteries {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .artwork { transition: none; }
  }
</style>
