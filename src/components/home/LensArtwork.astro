  <path d="M145 208L182 202L213 192L238 197L278 179L294 185L314 171L331 176L357 162L384 182L409 175L429 182L466 154L489 166L519 160L547 182L565 176L591 194L626 196L655 206V215H145Z" fill="url(#aurora-ridge)"/>
