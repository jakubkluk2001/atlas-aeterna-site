<span class="glass-image-rim" aria-hidden="true"></span>

<style>
  .glass-image-rim {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
  }

  .glass-image-rim::before,
  .glass-image-rim::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .glass-image-rim::after {
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--glass-image-glint) 87%, transparent),
      inset 1px 0 0 color-mix(in srgb, var(--glass-image-glint) 38%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--glass-image-glint) 28%, transparent),
      inset -1px -2px 3px color-mix(in srgb, var(--glass-image-depth) 46%, transparent);
  }

  @supports (mask-composite: exclude) {
    .glass-image-rim::before {
      padding: var(--glass-image-edge-width);
      background: linear-gradient(
        138deg,
        color-mix(in srgb, var(--glass-image-glint) 82%, transparent),
        color-mix(in srgb, var(--glass-image-glint) 30%, transparent) 27%,
        color-mix(in srgb, var(--glass-image-tint) 23%, transparent) 54%,
        color-mix(in srgb, var(--glass-image-depth) 52%, transparent) 87%,
        color-mix(in srgb, var(--glass-image-tint) 49%, transparent)
      );
      backdrop-filter: blur(1px) saturate(1.14);
      mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      mask-composite: exclude;
    }

    .glass-image-rim::after {
      outline: 1px solid color-mix(in srgb, var(--glass-image-glint) 32%, transparent);
      outline-offset: calc(-1 * var(--glass-image-edge-width));
    }
  }
</style>

<style is:global>
  :root {
    --glass-image-edge-width: clamp(4px, 0.52vw, 8px);
    --glass-image-surface: #e6e8e4;
    --glass-image-glint: #f9fcf7;
    --glass-image-tint: #a4b3ab;
    --glass-image-depth: #3b5046;
  }

  [data-case-theme="forest"] {
    --glass-image-surface: #e2e7d9;
    --glass-image-glint: #fff3cf;
    --glass-image-tint: #99ad80;
    --glass-image-depth: #435740;
  }

  :is([data-case-theme="open-ocean"], [data-case-theme="ocean"]) {
    --glass-image-surface: #deeaef;
    --glass-image-glint: #eafaff;
    --glass-image-tint: #79a6bc;
    --glass-image-depth: #2b4b62;
  }

  [data-case-theme="archive"] {
    --glass-image-surface: #eee6d6;
    --glass-image-glint: #fff4d9;
    --glass-image-tint: #ba9c69;
    --glass-image-depth: #634d34;
  }

  [data-case-theme="desert"] {
    --glass-image-surface: #f1e1d0;
    --glass-image-glint: #fff0d6;
    --glass-image-tint: #d49e77;
    --glass-image-depth: #805742;
  }

  [data-case-theme="ice"] {
    --glass-image-surface: #e0eef1;
    --glass-image-glint: #f2fdff;
    --glass-image-tint: #90c4d4;
    --glass-image-depth: #385b70;
  }

  [data-case-theme="twilight"] {
    --glass-image-surface: #eae4ee;
    --glass-image-glint: #f8edff;
    --glass-image-tint: #a891b8;
    --glass-image-depth: #5b456a;
  }

  [data-country-theme="poland"] {
    --glass-image-surface: #f0e3e1;
    --glass-image-glint: #fff0e8;
    --glass-image-tint: #cc9299;
    --glass-image-depth: #793f50;
  }

  [data-country-theme="united-states"] {
    --glass-image-surface: #e1e8ef;
    --glass-image-glint: #f1f7ff;
    --glass-image-tint: #91a9c5;
    --glass-image-depth: #425573;
  }
</style>
