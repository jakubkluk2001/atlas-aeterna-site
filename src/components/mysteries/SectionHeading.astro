---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="section-heading">
  <span class="section-number" aria-hidden="true">{number}</span>
  <h2>{title}</h2>
  <span class="section-rule" aria-hidden="true"></span>
</div>

<style>
  .section-heading {
    margin-bottom: 28px;

    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;

    gap: 15px;
  }

  .section-number {
    width: 34px;
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    color: #7b8291;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.80),
        rgba(241, 245, 252, 0.53)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: 50%;

    box-shadow:
      0 8px 18px rgba(55, 67, 95, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1);

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;

    color: #1d2029;

    font-size: clamp(33px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: 0.012em;
  }

  .section-rule {
    height: 1px;

    display: block;

    background:
      linear-gradient(
        to right,
        rgba(65, 76, 102, 0.16),
        transparent
      );
  }

  @media (max-width: 650px) {
    .section-heading {
      margin-bottom: 21px;
      gap: 11px;
    }

    .section-number {
      width: 30px;
    }

    h2 {
      font-size: 32px;
    }
  }
</style>
