---
import SectionHeading from "./SectionHeading.astro";

interface TimelineEvent {
  date: string;
  title: string;
  description: string;
}

interface Props {
  events: readonly TimelineEvent[];
  id?: string;
  number?: string;
  title?: string;
}

const {
  events,
  id = "timeline",
  number = "02",
  title = "Timeline",
} = Astro.props;
---

<section id={id} class="content-section timeline-section">
  <SectionHeading number={number} title={title} />

  <div class="timeline-shell">
    <div class="timeline">
      {events.map((event) => (
        <article class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>

          <div class="timeline-content">
            <p class="timeline-date">{event.date}</p>
            <h3>{event.title}</h3>
            <p>{event.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .content-section {
    width: min(100%, 1080px);

    margin: 0 auto;
    padding: 74px 0 8px;

    scroll-margin-top: 158px;
  }

  .timeline-section {
    padding-bottom: 22px;
  }

  .timeline-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 7% 4%,
        rgba(118, 171, 249, 0.15),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 98%,
        rgba(228, 174, 109, 0.15),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.78),
        rgba(246, 249, 255, 0.48)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }

  .timeline-shell::before {
    content: "";

    width: 360px;
    aspect-ratio: 1;

    position: absolute;
    right: -190px;
    bottom: -210px;
    z-index: -1;

    border: 1px solid rgba(92, 71, 49, 0.12);
    border-radius: 50%;

    box-shadow:
      0 0 0 42px rgba(255, 255, 255, 0.06),
      0 0 0 84px rgba(92, 71, 49, 0.025);

    pointer-events: none;
  }

  .timeline {
    max-width: 900px;

    position: relative;

    padding-left: 44px;
  }

  .timeline::before {
    content: "";

    position: absolute;

    top: 13px;
    bottom: 13px;
    left: 8px;

    width: 2px;

    background:
      linear-gradient(
        to bottom,
        rgba(120, 167, 238, 0.64),
        rgba(169, 140, 217, 0.45),
        rgba(218, 168, 101, 0.50)
      );

    border-radius: 999px;

    box-shadow: 0 0 16px rgba(123, 148, 205, 0.16);
  }

  .timeline-item {
    position: relative;

    margin-bottom: 17px;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-marker {
    width: 18px;
    aspect-ratio: 1;

    position: absolute;

    top: 31px;
    left: -44px;

    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(213, 225, 249, 0.92) 45%,
        rgba(115, 150, 219, 0.72)
      );

    border: 1px solid rgba(255, 255, 255, 0.94);
    border-radius: 50%;

    box-shadow:
      0 0 0 5px rgba(125, 161, 230, 0.11),
      0 8px 18px rgba(69, 87, 128, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .timeline-item:nth-child(3n + 2) .timeline-marker {
    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(226, 216, 244, 0.92) 45%,
        rgba(159, 131, 207, 0.72)
      );

    box-shadow:
      0 0 0 5px rgba(162, 137, 211, 0.10),
      0 8px 18px rgba(88, 73, 119, 0.17),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .timeline-item:nth-child(3n) .timeline-marker {
    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(245, 224, 192, 0.92) 45%,
        rgba(202, 148, 78, 0.72)
      );

    box-shadow:
      0 0 0 5px rgba(211, 161, 93, 0.10),
      0 8px 18px rgba(117, 82, 43, 0.17),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }

  .timeline-content {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding: 26px 30px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.52)
      );

    border: 1px solid rgba(255, 255, 255, 0.90);
    border-radius: 22px;

    box-shadow:
      0 13px 32px rgba(50, 62, 88, 0.075),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

    transition:
      transform 0.30s var(--ease-out),
      box-shadow 0.30s ease;
  }

  .timeline-content::before {
    content: "";

    width: 150px;
    height: 180px;

    position: absolute;
    top: -130px;
    right: -48px;
    z-index: -1;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(121, 170, 245, 0.18),
        transparent 70%
      );

    transition: transform 0.42s var(--ease-out);
  }

  .timeline-item:nth-child(3n + 2) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(170, 141, 218, 0.17),
        transparent 70%
      );
  }

  .timeline-item:nth-child(3n) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(222, 170, 99, 0.18),
        transparent 70%
      );
  }

  .timeline-content:hover {
    transform: translateY(-3px);

    box-shadow:
      0 20px 42px rgba(50, 62, 88, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }

  .timeline-content:hover::before {
    transform: translate(-8px, 9px) scale(1.08);
  }

  .timeline-date {
    margin: 0 0 11px;

    color: #7d94c5;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .timeline-item:nth-child(3n + 2) .timeline-date {
    color: #967fbd;
  }

  .timeline-item:nth-child(3n) .timeline-date {
    color: #ae7f47;
  }

  .timeline-content h3 {
    margin: 0 0 11px;

    color: #1e212b;

    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.3;
  }

  .timeline-content p:last-child {
    max-width: 700px;

    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.82;
  }

  @media (max-width: 650px) {
    .content-section {
      padding-top: 54px;
      scroll-margin-top: 145px;
    }

    .timeline-shell {
      padding: 23px 17px;

      border-radius: 24px;
    }

    .timeline {
      padding-left: 32px;
    }

    .timeline::before {
      left: 6px;
    }

    .timeline-marker {
      width: 15px;

      top: 27px;
      left: -32px;

      box-shadow:
        0 0 0 4px rgba(125, 161, 230, 0.10),
        0 7px 15px rgba(69, 87, 128, 0.17),
        inset 0 1px 0 rgba(255, 255, 255, 1);
    }

    .timeline-content {
      padding: 22px 20px;

      border-radius: 19px;
    }

    .timeline-content h3 {
      font-size: 20px;
    }

    .timeline-content p:last-child {
      font-size: 13px;
    }
  }

  @supports not (
    (backdrop-filter: blur(1px))
    or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .timeline-shell,
    .timeline-content {
      background-color: rgba(250, 250, 249, 0.94);
    }
  }
</style>
