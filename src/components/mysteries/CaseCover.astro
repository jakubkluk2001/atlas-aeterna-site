---
import type { PlaceholderScene } from "./placeholder-scenes";
import "../../styles/detail-cover.css";

interface Props {
  title: string;
  id?: string;
  scene?: "forest" | "open-ocean" | PlaceholderScene;
  titleVariant?: "default" | "long" | "wide" | "stacked";
}

const { title, id = "overview", scene = "forest", titleVariant = "default" } = Astro.props;
const coverTitle = title.replace(/^The\s+/i, "");
---

<section class:list={["case-header", "detail-cover", titleVariant !== "default" && `detail-cover--${titleVariant}`]} id={id} data-case-cover={scene}>
  <canvas class="case-header__terrain" aria-hidden="true"></canvas>
  <div class="case-header__inner">
    <h1>{coverTitle}</h1>
  </div>
  <canvas class="case-header__foreground" aria-hidden="true"></canvas>
</section>

<script>
  import { renderRelief } from "./forest-relief";
  import { renderOpenOcean } from "./ocean-swell";
  import { placeholderScenes } from "./placeholder-scenes";

  const renderers = new Map([
    ["forest", renderRelief],
    ["open-ocean", renderOpenOcean],
    ...Object.entries(placeholderScenes),
  ]);

  for (const cover of document.querySelectorAll<HTMLElement>("[data-case-cover]")) {
    const terrain = cover.querySelector<HTMLCanvasElement>(".case-header__terrain");
    const foreground = cover.querySelector<HTMLCanvasElement>(".case-header__foreground");
    if (!terrain || !foreground) continue;

    const render = renderers.get(cover.dataset.caseCover ?? "") ?? renderRelief;
    const redraw = () => render(terrain, foreground, cover.clientWidth, cover.clientHeight);
    redraw();
    if (typeof ResizeObserver === "function") {
      new ResizeObserver(redraw).observe(cover);
    } else {
      window.addEventListener("resize", redraw);
    }
  }
</script>

<style is:global>
  .case-page[data-case-theme] .case-header:is(.detail-cover--long, .detail-cover--wide, .detail-cover--stacked) .case-header__inner {
    display: grid;
    align-content: center;
    min-inline-size: 0;
    min-block-size: calc(var(--detail-title-reference-size) * var(--detail-title-reference-leading));
  }

  .case-page[data-case-theme] .case-header:is(.detail-cover--long, .detail-cover--wide, .detail-cover--stacked) h1 {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    line-height: .94;
    text-align: center;
    text-wrap: balance;
  }

  .case-page[data-case-theme] .case-header.detail-cover--stacked h1 {
    /* Keep the two lines visually centred on the same axis as other titles. */
    line-height: .86;
    transform: translateY(-.2em);
  }
</style>
