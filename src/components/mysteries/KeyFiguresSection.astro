---
import SectionHeading from "./SectionHeading.astro";
import type { KeyFigure } from "./types";

interface Props {
  figures: readonly KeyFigure[];
  id: string;
  number: string;
  title: string;
  overline: string;
  overviewTitle: string;
  summary: string;
  interactionNote?: string;
}

const {
  figures,
  id,
  number,
  title,
  overline,
  overviewTitle,
  summary,
  interactionNote = "Swipe the gallery or use the arrows. Open a profile for the fuller case connection.",
} = Astro.props;

const initialEnd = Math.min(3, figures.length);
const initialRange = figures.length === 0
  ? "00"
  : initialEnd === 1
    ? "01"
    : `01–${String(initialEnd).padStart(2, "0")}`;
---

<section id={id} class="content-section figures-section">
  <SectionHeading number={number} title={title} />

  <div class="figures-shell" data-key-figures>
    <header class="figures-overview">
      <div class="figures-overview__intro">
        <p class="figures-overline">{overline}</p>
        <h3>{overviewTitle}</h3>
      </div>

      <div class="figures-overview__aside">
        <p class="figures-summary">{summary}</p>
      </div>
    </header>

    <div class="figures-toolbar">
      <div class="figures-navigation" aria-label="Key figures carousel controls">
        <p class="figures-counter" aria-live="polite" aria-atomic="true">
          <span data-figures-range>{initialRange}</span>
          <span aria-hidden="true">/</span>
          <span data-figures-total>{figures.length}</span>
        </p>

        <button
          class="figures-arrow figures-arrow--previous"
          type="button"
          aria-label="Show previous key figure"
          data-figures-previous
          disabled
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14.5 6.5 9 12l5.5 5.5" />
          </svg>
        </button>

        <button
          class="figures-arrow figures-arrow--next"
          type="button"
          aria-label="Show next key figure"
          data-figures-next
          disabled={figures.length <= 1}
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m9.5 6.5 5.5 5.5-5.5 5.5" />
          </svg>
        </button>
      </div>
    </div>

    <div
      class="figures-scroller"
      data-figures-scroller
      tabindex="0"
      aria-label="Key figure cards. Swipe horizontally or use the arrow controls."
    >
      <div class="figures-track" data-figures-track>
        {figures.map((figure) => (
          <article
            id={`figure-${figure.id}`}
            class:list={["figure-card", `figure-card--${figure.tone}`]}
            data-figure-card
            aria-labelledby={`figure-title-${figure.id}`}
          >
            <div class="figure-portrait" data-figure-portrait>
              <div class="figure-portrait__fallback" aria-hidden="true">
                <span class="figure-portrait__grid"></span>
                <span class="figure-portrait__ring figure-portrait__ring--one"></span>
                <span class="figure-portrait__ring figure-portrait__ring--two"></span>
                <span class="figure-portrait__initials">{figure.initials}</span>
                <span class="figure-portrait__fallback-label">Portrait unavailable</span>
              </div>

              {figure.image && (
                <img
                  src={figure.image}
                  alt={figure.alt}
                  loading="lazy"
                  decoding="async"
                  data-figure-image
                />
              )}

              <span class="figure-portrait__number" aria-hidden="true">{figure.number}</span>
            </div>

            <div class="figure-card__body">
              <p class="figure-card__role">
                <span>{figure.number}</span>
                <span class="figure-card__rule" aria-hidden="true"></span>
                {figure.role}
              </p>

              <h3 id={`figure-title-${figure.id}`}>{figure.name}</h3>
              <p class="figure-card__dates">{figure.dates}</p>
              <p class="figure-card__summary">{figure.summary}</p>

              <button
                class="figure-card__profile-button"
                type="button"
                data-figure-open={`figure-dialog-${figure.id}`}
                aria-haspopup="dialog"
                aria-controls={`figure-dialog-${figure.id}`}
              >
                <span>View profile</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h13M13 7l5 5-5 5" />
                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>

    <p class="figures-interaction-note">{interactionNote}</p>
  </div>

  {figures.map((figure) => (
    <dialog
      class:list={["figure-dialog", `figure-dialog--${figure.tone}`]}
      id={`figure-dialog-${figure.id}`}
      data-figure-dialog
      aria-labelledby={`figure-dialog-title-${figure.id}`}
      aria-describedby={`figure-dialog-copy-${figure.id}`}
    >
      <div class="figure-dialog__panel">
        <button
          class="figure-dialog__close"
          type="button"
          aria-label={`Close ${figure.name} profile`}
          data-figure-close
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m7 7 10 10M17 7 7 17" />
          </svg>
        </button>

        <div class="figure-dialog__visual">
          <div class="figure-dialog__portrait" data-figure-portrait>
            <div class="figure-portrait__fallback" aria-hidden="true">
              <span class="figure-portrait__grid"></span>
              <span class="figure-portrait__ring figure-portrait__ring--one"></span>
              <span class="figure-portrait__ring figure-portrait__ring--two"></span>
              <span class="figure-portrait__initials">{figure.initials}</span>
              <span class="figure-portrait__fallback-label">Portrait unavailable</span>
            </div>

            {figure.image && (
              <img
                src={figure.image}
                alt={figure.alt}
                loading="lazy"
                decoding="async"
                data-figure-image
              />
            )}

            <span class="figure-dialog__number" aria-hidden="true">{figure.number}</span>
          </div>
        </div>

        <div class="figure-dialog__content">
          <p class="figure-dialog__eyebrow">Key figure {figure.number}</p>
          <h3 id={`figure-dialog-title-${figure.id}`}>{figure.name}</h3>

          <p class="figure-dialog__meta">
            <span>{figure.dates}</span>
            <span aria-hidden="true"></span>
            <span>{figure.role}</span>
          </p>

          <p class="figure-dialog__copy" id={`figure-dialog-copy-${figure.id}`}>
            {figure.profile}
          </p>

          <dl class="figure-dialog__details">
            {figure.details.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))}
          </dl>

          <div class="figure-dialog__references">
            <p>Related records</p>
            <div>
              {figure.references.map((reference) => (
                <a href={reference.href} data-figure-reference>
                  <span>{reference.label}</span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h13M13 7l5 5-5 5" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  const figurePrefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  const figureScrollBehavior: ScrollBehavior = figurePrefersReducedMotion
    ? "auto"
    : "smooth";

  const figurePortraits = Array.from(
    document.querySelectorAll("[data-figure-portrait]")
  ).filter((portrait) => portrait instanceof HTMLElement);

  figurePortraits.forEach((portrait) => {
    const image = portrait.querySelector("[data-figure-image]");

    if (!(image instanceof HTMLImageElement)) {
      portrait.classList.add("is-missing");
      return;
    }

    const markAvailable = () => portrait.classList.remove("is-missing");
    const markMissing = () => portrait.classList.add("is-missing");

    image.addEventListener("load", markAvailable);
    image.addEventListener("error", markMissing);

    if (image.complete) {
      image.naturalWidth > 0 ? markAvailable() : markMissing();
    }
  });

  const keyFigureSections = Array.from(
    document.querySelectorAll("[data-key-figures]")
  ).filter((section) => section instanceof HTMLElement);

  keyFigureSections.forEach((keyFigures) => {
    const scroller = keyFigures.querySelector("[data-figures-scroller]");
    const track = keyFigures.querySelector("[data-figures-track]");
    const previousButton = keyFigures.querySelector("[data-figures-previous]");
    const nextButton = keyFigures.querySelector("[data-figures-next]");
    const rangeLabel = keyFigures.querySelector("[data-figures-range]");

    const cards = Array.from(
      keyFigures.querySelectorAll("[data-figure-card]")
    ).filter((card) => card instanceof HTMLElement);

    let carouselFrame = 0;

    const getSubstantiallyVisibleCards = () => {
      if (!(scroller instanceof HTMLElement)) return [];
      const viewport = scroller.getBoundingClientRect();

      return cards.filter((card) => {
        const rect = card.getBoundingClientRect();
        const overlap =
          Math.min(rect.right, viewport.right) -
          Math.max(rect.left, viewport.left);

        return overlap >= Math.min(rect.width * 0.55, 120);
      });
    };

    const updateCarousel = () => {
      carouselFrame = 0;
      if (!(scroller instanceof HTMLElement)) return;

      const substantiallyVisible = getSubstantiallyVisibleCards();
      const firstVisible = substantiallyVisible[0] ?? cards[0];
      const lastVisible =
        substantiallyVisible[substantiallyVisible.length - 1] ?? firstVisible;

      const firstIndex = firstVisible ? cards.indexOf(firstVisible) + 1 : 0;
      const lastIndex = lastVisible ? cards.indexOf(lastVisible) + 1 : firstIndex;

      if (rangeLabel instanceof HTMLElement) {
        rangeLabel.textContent =
          firstIndex === lastIndex
            ? String(firstIndex).padStart(2, "0")
            : `${String(firstIndex).padStart(2, "0")}–${String(lastIndex).padStart(2, "0")}`;
      }

      const canScrollLeft = scroller.scrollLeft > 2;
      const canScrollRight =
        scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 2;

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.disabled = !canScrollLeft;
      }

      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = !canScrollRight;
      }
    };

    const requestCarouselUpdate = () => {
      if (carouselFrame !== 0) return;
      carouselFrame = window.requestAnimationFrame(updateCarousel);
    };

    const moveCarousel = (direction: -1 | 1) => {
      if (!(scroller instanceof HTMLElement) || cards.length === 0) return;

      const substantial = getSubstantiallyVisibleCards();
      const anchorCard = substantial[0] ?? cards[0];
      const anchorIndex = Math.max(0, cards.indexOf(anchorCard));
      const targetIndex = Math.min(
        cards.length - 1,
        Math.max(0, anchorIndex + direction)
      );
      const target = cards[targetIndex];

      if (!(target instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

      scroller.scrollTo({
        left: target.offsetLeft - track.offsetLeft,
        behavior: figureScrollBehavior,
      });
    };

    if (previousButton instanceof HTMLButtonElement) {
      previousButton.addEventListener("click", () => moveCarousel(-1));
    }

    if (nextButton instanceof HTMLButtonElement) {
      nextButton.addEventListener("click", () => moveCarousel(1));
    }

    if (scroller instanceof HTMLElement) {
      scroller.addEventListener("scroll", requestCarouselUpdate, { passive: true });
      scroller.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          moveCarousel(-1);
        }
        if (event.key === "ArrowRight") {
          event.preventDefault();
          moveCarousel(1);
        }
      });
    }

    if ("ResizeObserver" in window) {
      const figuresResizeObserver = new ResizeObserver(requestCarouselUpdate);
      figuresResizeObserver.observe(keyFigures);
      if (scroller instanceof HTMLElement) figuresResizeObserver.observe(scroller);
    }

    window.addEventListener("load", requestCarouselUpdate);
    updateCarousel();
  });

  const profileButtons = Array.from(
    document.querySelectorAll("[data-figure-open]")
  ).filter((button) => button instanceof HTMLButtonElement);

  const figureDialogs = Array.from(
    document.querySelectorAll("[data-figure-dialog]")
  ).filter((dialog) => dialog instanceof HTMLDialogElement);

  const closeFigureDialog = (dialog: HTMLDialogElement) => {
    dialog.close();
    document.documentElement.classList.remove("figure-dialog-open");
  };

  profileButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const dialogId = button.dataset.figureOpen;
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      if (!(dialog instanceof HTMLDialogElement)) return;

      document.documentElement.classList.add("figure-dialog-open");
      dialog.showModal();
    });
  });

  figureDialogs.forEach((dialog) => {
    const closeButton = dialog.querySelector("[data-figure-close]");
    const references = dialog.querySelectorAll("[data-figure-reference]");

    if (closeButton instanceof HTMLButtonElement) {
      closeButton.addEventListener("click", () => closeFigureDialog(dialog));
    }

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeFigureDialog(dialog);
    });

    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("figure-dialog-open");
    });

    references.forEach((reference) => {
      reference.addEventListener("click", () => closeFigureDialog(dialog));
    });
  });
</script>

<style>
  .content-section {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding: 74px 0 8px;
    scroll-margin-top: 158px;
  }

  .figures-section {
    padding-bottom: 22px;
  }


  .figures-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px)
      clamp(28px, 4.2vw, 48px);

    background:
      radial-gradient(
        circle at 7% 4%,
        rgba(118, 169, 239, 0.14),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 8%,
        rgba(217, 173, 114, 0.14),
        transparent 31%
      ),
      radial-gradient(
        circle at 89% 97%,
        rgba(165, 139, 217, 0.12),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.49)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .figures-shell::before {
    content: "";

    width: 450px;
    aspect-ratio: 1;

    position: absolute;
    right: -270px;
    top: 145px;
    z-index: -1;

    border: 1px solid rgba(81, 70, 60, 0.09);
    border-radius: 50%;

    box-shadow:
      0 0 0 56px rgba(255, 255, 255, 0.045),
      0 0 0 112px rgba(81, 70, 60, 0.020);

    pointer-events: none;
  }


  .figures-overview {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(310px, 0.82fr);
    align-items: end;

    gap: clamp(24px, 4vw, 56px);

    padding:
      2px
      4px
      clamp(26px, 3.5vw, 38px);

    border-bottom: 1px solid rgba(66, 76, 99, 0.10);
  }


  .figures-overline {
    margin: 0 0 10px;

    color: #92784f;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  .figures-overview h3 {
    max-width: 650px;

    margin: 0;

    color: #1d2029;

    font-size: clamp(25px, 3.1vw, 38px);
    line-height: 1.25;
  }


  .figures-overview__aside {
    min-width: 0;
  }


  .figures-summary {
    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.80;
  }


  .figures-toolbar {
    position: relative;
    z-index: 2;

    margin-top: clamp(24px, 3vw, 32px);

    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 18px;
  }


  .figures-navigation {
    flex: 0 0 auto;

    display: flex;
    align-items: center;

    gap: 7px;
  }


  .figures-counter {
    min-width: 74px;

    margin: 0 5px 0 0;

    display: inline-flex;
    align-items: baseline;
    justify-content: flex-end;

    gap: 5px;

    color: #8d94a2;

    font-family: var(--font-ui);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
  }


  .figures-counter span:first-child {
    color: #4f5664;

    font-size: 10px;
  }


  .figures-arrow {
    width: 36px;
    aspect-ratio: 1;

    padding: 0;

    display: grid;
    place-items: center;

    color: #5f6776;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.86),
        rgba(239, 243, 250, 0.64)
      );

    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 50%;

    box-shadow:
      0 9px 20px rgba(51, 63, 91, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1);

    cursor: pointer;

    transition:
      color 0.20s ease,
      background 0.20s ease,
      opacity 0.20s ease,
      transform 0.20s var(--ease-out);
  }


  .figures-arrow:hover:not(:disabled) {
    color: #252b37;
    background: rgba(255, 255, 255, 0.96);

    transform: scale(1.04);
  }


  .figures-arrow:disabled {
    opacity: 0.34;
    cursor: default;
  }


  .figures-arrow svg {
    width: 16px;
    height: 16px;
  }


  .figures-arrow path {
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .figures-scroller {
    position: relative;
    z-index: 1;

    margin-top: 18px;
    padding: 3px 3px 18px;

    overflow-x: auto;
    overscroll-behavior-inline: contain;

    scroll-snap-type: x mandatory;
    scroll-padding-inline: 3px;
    scrollbar-width: none;

    mask-image:
      linear-gradient(
        to right,
        black 0,
        black calc(100% - 18px),
        transparent
      );

    -webkit-mask-image:
      linear-gradient(
        to right,
        black 0,
        black calc(100% - 18px),
        transparent
      );
  }


  .figures-scroller::-webkit-scrollbar {
    display: none;
  }


  .figures-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 36px) / 3);

    gap: 18px;
  }


  .figure-card {
    --figure-accent: #7a818f;
    --figure-accent-rgb: 122, 129, 143;
    --figure-accent-soft: rgba(122, 129, 143, 0.10);
    --figure-accent-faint: rgba(122, 129, 143, 0.060);

    min-width: 0;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 93% 4%,
        var(--figure-accent-soft),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.82),
        rgba(247, 248, 252, 0.55)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: 25px;

    box-shadow:
      0 16px 38px rgba(50, 62, 88, 0.085),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

    scroll-snap-align: start;

    transition:
      transform 0.30s var(--ease-out),
      box-shadow 0.30s ease;
  }


  .figure-card:hover {
    transform: translateY(-3px);

    box-shadow:
      0 23px 49px rgba(50, 62, 88, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .figure-card--gold,
  .figure-dialog--gold {
    --figure-accent: #ad7d42;
    --figure-accent-rgb: 173, 125, 66;
    --figure-accent-soft: rgba(217, 167, 99, 0.15);
    --figure-accent-faint: rgba(173, 125, 66, 0.078);
  }


  .figure-card--blue,
  .figure-dialog--blue {
    --figure-accent: #6485bd;
    --figure-accent-rgb: 100, 133, 189;
    --figure-accent-soft: rgba(112, 151, 214, 0.13);
    --figure-accent-faint: rgba(100, 133, 189, 0.067);
  }


  .figure-card--violet,
  .figure-dialog--violet {
    --figure-accent: #816aa6;
    --figure-accent-rgb: 129, 106, 166;
    --figure-accent-soft: rgba(158, 130, 202, 0.14);
    --figure-accent-faint: rgba(129, 106, 166, 0.069);
  }


  .figure-card--neutral,
  .figure-dialog--neutral {
    --figure-accent: #737a87;
    --figure-accent-rgb: 115, 122, 135;
    --figure-accent-soft: rgba(115, 122, 135, 0.10);
    --figure-accent-faint: rgba(115, 122, 135, 0.057);
  }


  .figure-portrait,
  .figure-dialog__portrait {
    width: 100%;
    aspect-ratio: 4 / 5;

    position: relative;
    isolation: isolate;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 22% 14%,
        rgba(255, 255, 255, 0.78),
        transparent 31%
      ),
      radial-gradient(
        circle at 80% 78%,
        var(--figure-accent-soft),
        transparent 44%
      ),
      linear-gradient(
        145deg,
        rgba(231, 237, 247, 0.94),
        rgba(244, 242, 239, 0.82)
      );

    border-bottom: 1px solid rgba(255, 255, 255, 0.84);
  }


  .figure-portrait::after,
  .figure-dialog__portrait::after {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 3;

    background:
      linear-gradient(
        118deg,
        rgba(255, 255, 255, 0.34),
        transparent 24%,
        transparent 71%,
        rgba(255, 255, 255, 0.12)
      ),
      linear-gradient(
        to top,
        rgba(27, 31, 42, 0.12),
        transparent 31%
      );

    pointer-events: none;
  }


  .figure-portrait img,
  .figure-dialog__portrait img {
    width: 100%;
    height: 100%;

    position: relative;
    z-index: 2;

    display: block;

    object-fit: cover;

    filter:
      saturate(0.82)
      contrast(1.02)
      sepia(0.05);

    transition:
      opacity 0.22s ease,
      transform 0.55s var(--ease-out);
  }


  .figure-card:hover .figure-portrait img {
    transform: scale(1.025);
  }


  .figure-portrait.is-missing img,
  .figure-dialog__portrait.is-missing img {
    opacity: 0;
  }


  .figure-portrait__fallback {
    position: absolute;
    inset: 0;
    z-index: 1;

    overflow: hidden;
  }


  .figure-portrait__grid {
    position: absolute;
    inset: 0;

    opacity: 0.24;

    background-image:
      linear-gradient(
        rgba(67, 76, 99, 0.11) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(67, 76, 99, 0.11) 1px,
        transparent 1px
      );

    background-size: 38px 38px;

    mask-image:
      radial-gradient(
        circle at 52% 47%,
