---
import PlaceholderLens from "./PlaceholderLens.astro";

interface Props {
  kind: "history" | "geography";
}

const { kind } = Astro.props;
---

<div class="placeholder">
  <p>This part of Atlas Aeterna is still in development.</p>
  <div class="lens"><PlaceholderLens kind={kind} /></div>
</div>

<style>
  .placeholder {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 3.5svh, 2.25rem);
    padding-block: clamp(0.25rem, 1.5svh, 1.25rem) clamp(1rem, 5svh, 3rem);
    text-align: center;
  }

  p {
    max-inline-size: 38rem;
    margin: 0;
    color: #30364b;
    font-size: clamp(1rem, 1.62vw, 1.23rem);
    line-height: 1.55;
    text-wrap: balance;
  }

  .lens {
    inline-size: min(100%, clamp(19rem, 56vw, 42rem));
  }
</style>
