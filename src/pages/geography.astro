---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Geography | Atlas Aeterna"
  description="The geography collection of Atlas Aeterna is still in development."
>
  <section class="placeholder-page geography-page">
    <svg
      class="contour-lines contour-lines--left"
      viewBox="0 0 620 620"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-36 448C42 357 98 386 158 314C216 245 221 157 318 112C414 67 499 107 656 -14" />
      <path d="M-18 485C63 396 128 418 190 346C254 270 263 188 354 143C450 96 529 131 651 39" />
      <path d="M7 523C85 446 159 453 224 384C294 311 304 225 390 182C476 139 548 155 644 95" />
      <path d="M48 562C124 504 189 499 260 432C334 363 349 284 426 241C500 200 562 204 637 164" />
      <path d="M114 601C187 549 246 544 314 485C383 423 400 347 468 304C530 265 582 264 637 241" />
    </svg>

    <svg
      class="contour-lines contour-lines--right"
      viewBox="0 0 620 620"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-36 448C42 357 98 386 158 314C216 245 221 157 318 112C414 67 499 107 656 -14" />
      <path d="M-18 485C63 396 128 418 190 346C254 270 263 188 354 143C450 96 529 131 651 39" />
      <path d="M7 523C85 446 159 453 224 384C294 311 304 225 390 182C476 139 548 155 644 95" />
      <path d="M48 562C124 504 189 499 260 432C334 363 349 284 426 241C500 200 562 204 637 164" />
      <path d="M114 601C187 549 246 544 314 485C383 423 400 347 468 304C530 265 582 264 637 241" />
    </svg>

    <div class="geography-object" aria-hidden="true">
      <span class="geography-object__orbit geography-object__orbit--outer"></span>
      <span class="geography-object__orbit geography-object__orbit--middle"></span>
      <span class="geography-object__orbit geography-object__orbit--inner"></span>
      <span class="geography-object__axis"></span>

      <span class="geography-object__sphere">
        <span class="geography-object__latitude geography-object__latitude--one"></span>
        <span class="geography-object__latitude geography-object__latitude--two"></span>
        <span class="geography-object__latitude geography-object__latitude--three"></span>
        <span class="geography-object__meridian geography-object__meridian--one"></span>
        <span class="geography-object__meridian geography-object__meridian--two"></span>
      </span>

      <span class="geography-object__node geography-object__node--one"></span>
      <span class="geography-object__node geography-object__node--two"></span>
    </div>

    <div class="placeholder-content">
      <p class="eyebrow">
        Atlas Aeterna
      </p>

      <h1>Geography</h1>

      <p class="message">
        This part of Atlas Aeterna is still in development.
      </p>
    </div>

    <span class="edge-mark edge-mark--top-left" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--top-right" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--bottom-left" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--bottom-right" aria-hidden="true"></span>
  </section>
</BaseLayout>


<style>
  .placeholder-page {
    min-height: min(790px, calc(100svh - 118px));

    position: relative;
    isolation: isolate;

    display: grid;
    place-items: center;

    overflow: hidden;

    padding:
      clamp(88px, 10vw, 140px)
      clamp(24px, 6vw, 80px);

    background:
      radial-gradient(
        circle at 8% 7%,
        rgba(111, 170, 255, 0.33),
        transparent 34%
      ),
      radial-gradient(
        circle at 92% 9%,
        rgba(164, 144, 242, 0.25),
        transparent 35%
      ),
      radial-gradient(
        circle at 50% 110%,
        rgba(237, 181, 143, 0.22),
        transparent 41%
      ),
      linear-gradient(
        142deg,
        rgba(255, 255, 255, 0.77),
        rgba(245, 249, 255, 0.46) 48%,
        rgba(255, 249, 245, 0.47)
      );

    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: clamp(30px, 3.2vw, 48px);

    box-shadow:
      0 44px 110px rgba(50, 62, 88, 0.13),
      0 12px 34px rgba(50, 62, 88, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(58, 69, 94, 0.045);

    backdrop-filter:
      blur(30px)
      saturate(155%);

    -webkit-backdrop-filter:
      blur(30px)
      saturate(155%);

    text-align: center;
  }


  .placeholder-page::after {
    content: "";

    position: absolute;
    inset: 1px;
    z-index: 5;

    border-radius: inherit;

    background:
      linear-gradient(
        112deg,
        rgba(255, 255, 255, 0.58),
        transparent 25%,
        transparent 72%,
        rgba(255, 255, 255, 0.20)
      );

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 24%,
        transparent 76%,
        black
      );

    -webkit-mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 24%,
        transparent 76%,
        black
      );

    opacity: 0.54;
    pointer-events: none;
  }


  .placeholder-content {
    width: 100%;
    max-width: 980px;

    position: relative;
    z-index: 3;

    display: flex;
    flex-direction: column;
    align-items: center;

    animation:
      content-enter
      0.85s
      var(--ease-out)
      both;
  }


  .eyebrow {
    margin: 0 0 24px;
    padding: 9px 14px;

    color: #666d7d;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.74),
        rgba(247, 249, 254, 0.43)
      );

    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;

    box-shadow:
      0 10px 28px rgba(57, 69, 97, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.98);

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  h1 {
    margin: 0;

    background:
      linear-gradient(
        180deg,
        #171922 0%,
        #292d39 66%,
        #414654 100%
      );

    -webkit-background-clip: text;
    background-clip: text;

    font-size: clamp(66px, 10.2vw, 142px);
    line-height: 0.92;
    letter-spacing: 0.034em;

    -webkit-text-fill-color: transparent;

    filter: drop-shadow(0 2px 0 rgba(255, 255, 255, 0.36));
  }


  .message {
    max-width: 620px;

    margin: 30px 0 0;

    color: #68707f;

    font-family: var(--font-ui);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.8;
    text-wrap: balance;
  }


  /* ---------------------------------- */
  /* GEOGRAPHY OBJECT                   */
  /* ---------------------------------- */

  .geography-object {
    width: clamp(430px, 56vw, 790px);
    aspect-ratio: 1;

    position: absolute;
    top: 47%;
    left: 50%;
    z-index: -1;

    opacity: 0.72;

    filter:
      drop-shadow(0 36px 42px rgba(57, 70, 102, 0.13));

    transform: translate(-50%, -50%);
    pointer-events: none;

    animation:
      object-float
      11s
      ease-in-out
      infinite;
  }


  .geography-object__sphere {
    width: 55%;
    aspect-ratio: 1;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 29% 22%,
        rgba(255, 255, 255, 0.97),
        rgba(255, 255, 255, 0.44) 20%,
        rgba(145, 188, 244, 0.23) 49%,
        rgba(140, 153, 217, 0.14) 69%,
        rgba(237, 183, 151, 0.11) 88%
      );

    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 50%;

    box-shadow:
      inset 19px 23px 35px rgba(255, 255, 255, 0.48),
      inset -25px -35px 49px rgba(94, 126, 184, 0.17),
      0 37px 69px rgba(70, 87, 124, 0.14);

    transform: translate(-50%, -50%);
  }


  .geography-object__sphere::before {
    content: "";

    width: 68%;
    height: 34%;

    position: absolute;
    top: 7%;
    left: 13%;

    border-radius: 50%;

    background:
      radial-gradient(
        ellipse,
        rgba(255, 255, 255, 0.76),
        transparent 70%
      );

    filter: blur(7px);
    transform: rotate(-24deg);
  }


  .geography-object__sphere::after {
    content: "";

    width: 54%;
    aspect-ratio: 1;

    position: absolute;
    right: -4%;
    bottom: -12%;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(239, 178, 139, 0.22),
        transparent 70%
      );

    filter: blur(5px);
  }


  .geography-object__latitude,
  .geography-object__meridian {
    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    border: 1px solid rgba(51, 64, 93, 0.16);
    border-radius: 50%;
  }


  .geography-object__latitude--one {
    width: 86%;
    height: 31%;

    transform:
      translate(-50%, -50%)
      rotate(-7deg);
  }


  .geography-object__latitude--two {
    width: 76%;
    height: 23%;

    transform:
      translate(-50%, -50%)
      rotate(-7deg)
      translateY(-135%);
  }


  .geography-object__latitude--three {
    width: 74%;
    height: 22%;

    transform:
      translate(-50%, -50%)
      rotate(-7deg)
      translateY(139%);
  }


  .geography-object__meridian--one {
    width: 39%;
    height: 87%;

    transform:
      translate(-50%, -50%)
      rotate(15deg);
  }


  .geography-object__meridian--two {
    width: 68%;
    height: 88%;

    opacity: 0.78;

    transform:
      translate(-50%, -50%)
      rotate(15deg);
  }


  .geography-object__orbit {
    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    border: 1px solid rgba(50, 63, 94, 0.18);
    border-radius: 50%;

    box-shadow:
      0 0 18px rgba(255, 255, 255, 0.50),
      inset 0 0 18px rgba(255, 255, 255, 0.22);
  }


  .geography-object__orbit--outer {
    width: 93%;
    height: 35%;

    transform:
      translate(-50%, -50%)
      rotate(-18deg);
  }


  .geography-object__orbit--middle {
    width: 80%;
    height: 80%;

    border-color: rgba(55, 68, 101, 0.13);

    transform:
      translate(-50%, -50%)
      rotate(31deg);
  }


  .geography-object__orbit--inner {
    width: 41%;
    height: 92%;

    border-color: rgba(55, 68, 101, 0.15);

    transform:
      translate(-50%, -50%)
      rotate(28deg);
  }


  .geography-object__axis {
    width: 1px;
    height: 90%;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    background:
      linear-gradient(
        transparent,
        rgba(45, 57, 87, 0.21) 18%,
        rgba(45, 57, 87, 0.21) 82%,
        transparent
      );

    transform:
      translate(-50%, -50%)
      rotate(28deg);
  }


  .geography-object__node {
    width: 13px;
    aspect-ratio: 1;

    position: absolute;

    display: block;

    background:
      radial-gradient(
        circle at 32% 26%,
        white,
        rgba(199, 218, 252, 0.78) 42%,
        rgba(88, 112, 166, 0.42)
      );

    border: 1px solid rgba(255, 255, 255, 0.89);
    border-radius: 50%;

    box-shadow:
      0 8px 16px rgba(55, 67, 96, 0.18),
      inset 0 1px 0 white;
  }


  .geography-object__node--one {
    top: 24%;
    right: 7%;
  }


  .geography-object__node--two {
    width: 9px;

    bottom: 18%;
    left: 15%;
  }


  /* ---------------------------------- */
  /* CARTOGRAPHIC DETAILS               */
  /* ---------------------------------- */

  .contour-lines {
    width: min(45vw, 610px);

    position: absolute;
    z-index: -2;

    color: rgba(53, 69, 102, 0.18);

    opacity: 0.38;
    pointer-events: none;
  }


  .contour-lines path {
    stroke: currentColor;
    stroke-width: 1.15;
    vector-effect: non-scaling-stroke;
  }


  .contour-lines--left {
    left: -17%;
    bottom: -29%;

    transform: rotate(8deg);
  }


  .contour-lines--right {
    top: -31%;
    right: -16%;

    transform:
      rotate(188deg)
      scale(0.84);
  }


  /* ---------------------------------- */
  /* EDGE DETAILS                       */
  /* ---------------------------------- */

  .edge-mark {
    width: 44px;
    height: 44px;

    position: absolute;
    z-index: 4;

    opacity: 0.29;
    pointer-events: none;
  }


  .edge-mark::before,
  .edge-mark::after {
    content: "";

    position: absolute;

    background: rgba(62, 73, 99, 0.28);
    border-radius: 999px;
  }


  .edge-mark::before {
    width: 44px;
    height: 1px;
  }


  .edge-mark::after {
    width: 1px;
    height: 44px;
  }


  .edge-mark--top-left {
    top: 24px;
    left: 24px;
  }


  .edge-mark--top-right {
    top: 24px;
    right: 24px;

    transform: rotate(90deg);
  }


  .edge-mark--bottom-left {
    bottom: 24px;
    left: 24px;

    transform: rotate(-90deg);
  }


  .edge-mark--bottom-right {
    right: 24px;
    bottom: 24px;

    transform: rotate(180deg);
  }


  /* ---------------------------------- */
  /* MOTION                             */
  /* ---------------------------------- */

  @keyframes content-enter {
    from {
      opacity: 0;
      transform: translateY(17px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  @keyframes object-float {
    0%,
    100% {
      transform:
        translate(-50%, calc(-50% - 5px))
        rotate(-0.5deg);
    }

    50% {
      transform:
        translate(-50%, calc(-50% + 7px))
        rotate(0.7deg);
    }
  }


  /* ---------------------------------- */
  /* MOBILE                             */
  /* ---------------------------------- */

  @media (max-width: 650px) {
    .placeholder-page {
      min-height: calc(100svh - 93px);

      padding:
        82px
        18px
        72px;

      border-radius: 30px;
    }

    .eyebrow {
      margin-bottom: 22px;

      font-size: 9px;
      letter-spacing: 0.13em;
    }

    h1 {
      max-width: 100%;
      
      font-size: clamp(40px, 14vw, 68px);
      line-height: 0.96;
      letter-spacing: 0.022em;
    }

    .message {
      max-width: 340px;

      margin-top: 25px;

      font-size: 16px;
    }

    .geography-object {
      width: min(129vw, 540px);

      top: 44%;

      opacity: 0.55;
    }

    .contour-lines {
      width: 96vw;
    }

    .contour-lines--left {
      left: -53%;
      bottom: -9%;
    }

    .contour-lines--right {
      top: -9%;
      right: -51%;
    }

    .edge-mark {
      width: 30px;
      height: 30px;
    }

    .edge-mark::before {
      width: 30px;
    }

    .edge-mark::after {
      height: 30px;
    }

    .edge-mark--top-left,
    .edge-mark--top-right {
      top: 17px;
    }

    .edge-mark--bottom-left,
    .edge-mark--bottom-right {
      bottom: 17px;
    }

    .edge-mark--top-left,
    .edge-mark--bottom-left {
      left: 17px;
    }

    .edge-mark--top-right,
    .edge-mark--bottom-right {
      right: 17px;
    }
  }


  @supports not (
    (backdrop-filter: blur(1px))
    or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .placeholder-page,
    .eyebrow {
      background-color: rgba(248, 251, 255, 0.94);
    }
  }
</style>