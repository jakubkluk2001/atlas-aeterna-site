---
import unitedStatesFlag from "../assets/flags/united-states.svg?url";
import CountrySpotlights from "../components/sections/CountrySpotlights.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionOpening from "../components/sections/SectionOpening.astro";
---

<BaseLayout
  sectionPlaceholder
  title="Geography | Atlas Aeterna"
  description="The geography collection of Atlas Aeterna is still in development."
>
  <SectionOpening
    title="Geography"
    intro="Explore the places that make up our planet and the natural forces that shape them."
    titleId="placeholder-title"
  >
    <CountrySpotlights stories={[
      {
        country: "United States",
        title: "A World Within",
        href: "/geography/a-world-within",
        flag: unitedStatesFlag,
        tone: "blue",
        inDevelopment: true,
      },
    ]} />
  </SectionOpening>
</BaseLayout>
