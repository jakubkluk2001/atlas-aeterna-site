---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Atlas Aeterna | History, Geography & Mysteries"
  description="Explore history, geography, mysteries, legendary places and the stories that connect them all with Atlas Aeterna."
>

  <section class="hero">

    <div class="hero-content">

      <p class="eyebrow">
        History · Geography · Mysteries
      </p>


      <h1>
        Atlas Aeterna
      </h1>


      <p class="tagline">
        Explore the world differently.
      </p>


      <p class="intro">
        History, geography, mysteries and the stories
        that connect them all.
      </p>


      <div class="social-links">

        <a
          href="https://www.tiktok.com/@atlasaeterna"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>TikTok</span>

          <span
            class="arrow"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>


        <a
          href="https://www.youtube.com/@AtlasAeterna"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>YouTube</span>

          <span
            class="arrow"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>

      </div>


      <p class="construction">
        Atlas Aeterna is currently under construction.
      </p>

    </div>

  </section>

</BaseLayout>


<style>

  /* ---------------------------------- */
  /* HERO                               */
  /* ---------------------------------- */

  .hero {
    min-height: calc(100vh - 150px);

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 90px 40px;

    background:
      radial-gradient(
        circle at 8% 5%,
        rgba(102, 157, 255, 0.34),
        transparent 36%
      ),
      radial-gradient(
        circle at 92% 8%,
        rgba(175, 139, 255, 0.28),
        transparent 38%
      ),
      radial-gradient(
        circle at 50% 105%,
        rgba(255, 183, 127, 0.28),
        transparent 42%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.97),
        rgba(255, 255, 255, 0.76)
      );

    background-clip: padding-box;

    border: 1px solid rgba(255, 255, 255, 0.92);
    border-radius: 36px;

    box-shadow:
      0 30px 80px rgba(46, 55, 80, 0.10),
      0 8px 24px rgba(46, 55, 80, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 1);

    text-align: center;
  }


  /* ---------------------------------- */
  /* HERO CONTENT                       */
  /* ---------------------------------- */

  .hero-content {
    width: 100%;
    max-width: 900px;

    position: relative;

    animation:
      hero-enter
      0.8s
      cubic-bezier(0.22, 1, 0.36, 1)
      both;
  }


  .eyebrow {
    margin: 0 0 24px;

    color: #77777c;

    font-size: 13px;

    letter-spacing: 0.18em;

    text-transform: uppercase;
  }


  /* ---------------------------------- */
  /* TITLE                              */
  /* ---------------------------------- */

  h1 {
    margin: 0;

    color: #151517;

    font-size: clamp(58px, 8vw, 108px);

    font-weight: 400;

    line-height: 1;

    letter-spacing: 0.035em;

    text-wrap: balance;
  }


  /* ---------------------------------- */
  /* TAGLINE                            */
  /* ---------------------------------- */

  .tagline {
    margin: 34px 0 0;

    color: #202024;

    font-size: clamp(22px, 3vw, 34px);

    line-height: 1.3;
  }


  .intro {
    max-width: 650px;

    margin: 18px auto 0;

    color: #737378;

    font-size: 17px;

    line-height: 1.8;
  }


  /* ---------------------------------- */
  /* SOCIAL LINKS                       */
  /* ---------------------------------- */

  .social-links {
    margin-top: 38px;

    display: flex;
    justify-content: center;

    gap: 12px;
  }


  .social-links a {
    min-width: 145px;

    padding: 15px 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    color: #202024;

    background: rgba(255, 255, 255, 0.82);

    border: 1px solid rgba(20, 20, 25, 0.07);
    border-radius: 999px;

    box-shadow:
      0 8px 22px rgba(50, 55, 75, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);

    text-decoration: none;

    font-size: 14px;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }


  .social-links a:hover {
    background: #ffffff;

    transform: translateY(-3px);

    box-shadow:
      0 14px 30px rgba(50, 55, 75, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }


  .arrow {
    display: inline-block;

    color: #77777c;

    font-size: 15px;

    transition:
      transform 0.25s ease;
  }


  .social-links a:hover .arrow {
    transform:
      translate(2px, -2px);
  }


  /* ---------------------------------- */
  /* CONSTRUCTION NOTE                  */
  /* ---------------------------------- */

  .construction {
    margin: 30px 0 0;

    color: #99999e;

    font-size: 11px;

    letter-spacing: 0.08em;
  }


  /* ---------------------------------- */
  /* ENTRANCE ANIMATION                 */
  /* ---------------------------------- */

  @keyframes hero-enter {

    from {
      opacity: 0;

      transform: translateY(14px);
    }


    to {
      opacity: 1;

      transform: translateY(0);
    }

  }


  /* ---------------------------------- */
  /* MOBILE                             */
  /* ---------------------------------- */

  @media (max-width: 750px) {

    .hero {
      min-height: calc(100svh - 110px);

      padding: 70px 20px;

      border-radius: 24px;

      background:
        radial-gradient(
          circle at 0% 5%,
          rgba(102, 157, 255, 0.30),
          transparent 42%
        ),
        radial-gradient(
          circle at 100% 15%,
          rgba(175, 139, 255, 0.24),
          transparent 44%
        ),
        radial-gradient(
          circle at 50% 100%,
          rgba(255, 183, 127, 0.24),
          transparent 48%
        ),
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.97),
          rgba(255, 255, 255, 0.78)
        );
    }


    .hero-content {
      width: 100%;
      max-width: 100%;
    }


    .eyebrow {
      margin-bottom: 20px;

      font-size: 10px;

      letter-spacing: 0.11em;

      line-height: 1.8;
    }


    h1 {
      font-size: clamp(44px, 13vw, 68px);

      line-height: 1.06;

      letter-spacing: 0.025em;
    }


    .tagline {
      margin-top: 28px;

      font-size: 22px;
    }


    .intro {
      max-width: 440px;

      font-size: 14px;
    }


    .social-links {
      width: 100%;

      margin-top: 32px;

      flex-direction: column;
      align-items: center;
    }


    .social-links a {
      width: min(100%, 260px);
    }

  }

</style>