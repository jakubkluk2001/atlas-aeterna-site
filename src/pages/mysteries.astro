---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Mysteries | Atlas Aeterna">

  <h1>Mysteries</h1>

  <div class="case-files">

    <a class="case-file" href="/mysteries/amber-room">
      Amber Room
    </a>

    <a class="case-file" href="/mysteries/atlantis">
      Atlantis
    </a>

    <a class="case-file" href="/mysteries/el-dorado">
      El Dorado
    </a>

    <a class="case-file" href="/mysteries/oak-island">
      Oak Island
    </a>

    <a class="case-file" href="/mysteries/voynich-manuscript">
      Voynich Manuscript
    </a>

  </div>

</BaseLayout>


<style>

  /* ---------------------------------- */
  /* CASE FILE GRID                     */
  /* ---------------------------------- */

  .case-files {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;

    margin-top: 28px;
  }


  /* ---------------------------------- */
  /* CASE FILE                          */
  /* ---------------------------------- */

  .case-file {
    width: 100%;
    height: 110px;

    padding: 24px;

    display: flex;
    align-items: center;

    color: #171719;

    background:
      rgba(255, 255, 255, 0.72);

    border:
      1px solid
      rgba(20, 20, 25, 0.06);

    border-radius: 20px;

    box-shadow:
      0 8px 24px
      rgba(50, 55, 75, 0.05);

    text-decoration: none;

    line-height: 1.5;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }


  .case-file:hover {
    background: #ffffff;

    transform: translateY(-3px);

    box-shadow:
      0 14px 32px
      rgba(50, 55, 75, 0.10);
  }


  /* ---------------------------------- */
  /* TABLET                             */
  /* ---------------------------------- */

  @media (max-width: 900px) {

    .case-files {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

  }


  /* ---------------------------------- */
  /* MOBILE                             */
  /* ---------------------------------- */

  @media (max-width: 600px) {

    .case-files {
      grid-template-columns: 1fr;

      gap: 14px;
    }


    .case-file {
      height: 96px;

      padding: 22px;
    }

  }

</style>