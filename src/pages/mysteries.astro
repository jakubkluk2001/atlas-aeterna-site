---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mysteryCases, type MysteryCase } from "../data/mystery-cases";
---

<BaseLayout
  sectionPlaceholder
  title="Mysteries | Atlas Aeterna"
  description="Explore lost treasures, legendary places, unexplained events and enduring mysteries with Atlas Aeterna."
>
  <section class="mysteries-index" aria-labelledby="mysteries-title">
    <h1 id="mysteries-title">Mysteries</h1>

    <ul class="case-grid" aria-label="Mystery cases">
      {mysteryCases.map((caseFile: MysteryCase) => {
        const hasPage = caseFile.published || caseFile.routeReady;
        const Card = hasPage ? "a" : "div";

        return (
          <li>
            <Card
              class:list={["case-card", `case-card--${caseFile.theme}`]}
              href={hasPage ? `/mysteries/${caseFile.slug}` : undefined}
            >
              <div class="case-artwork">
                <img src={caseFile.artwork} alt="" width="800" height="280" decoding="async" />
              </div>
              <h2>{caseFile.title}</h2>
              <div class="case-footer">
                {!caseFile.published && <p class="case-status">In development</p>}
                {hasPage && <span class="case-arrow" aria-hidden="true">→</span>}
              </div>
            </Card>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>

<style>
  .mysteries-index {
    inline-size: min(92%, 82.5rem);
    margin-inline: auto;
    padding-block: clamp(3.25rem, 7.1svh, 5.5rem) 4.4rem;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    color: #141724;
  }

  h1 {
    margin-block-end: clamp(1.65rem, 3.15vw, 2.65rem);
    padding-inline-start: clamp(0.15rem, 0.8vw, 0.75rem);
    font-size: clamp(2.65rem, 6.25vw, 5.2rem);
    line-height: 1.03;
    letter-spacing: 0.045em;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.95rem, 1.65vw, 1.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-grid > li { min-inline-size: 0; }

  .case-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.5rem;
    min-block-size: 100%;
    padding: clamp(1.05rem, 2.15vw, 1.75rem);
    border: 1px solid #ffffffbf;
    border-radius: 1.3rem;
    background:
      radial-gradient(ellipse 115% 100% at 90% 5%, var(--wash), transparent 85%),
      linear-gradient(145deg, #ffffff86, #ffffff3d);
    box-shadow: inset 0 0 0 1px var(--edge), 0 7px 24px #3a46640b;
    text-decoration: none;
  }

  .case-card::before {
    content: "";
    position: absolute;
    inset: 7px 18% auto 7%;
    block-size: 1px;
    background: linear-gradient(90deg, transparent, #fff 22%, #fff9 58%, transparent);
    pointer-events: none;
  }

  .case-card--forest { --wash: #c4dabbc9; --edge: #678d622d; --accent: #465e40; }
  .case-card--ocean { --wash: #b8cbdfd6; --edge: #54739036; --accent: #405b73; }
  .case-card--archive { --wash: #eadcc1dc; --edge: #8b765933; --accent: #705c3e; }
  .case-card--ice { --wash: #e8f9ffee; --edge: #7199b53d; --accent: #3d657b; }
  .case-card--desert { --wash: #edd5b6df; --edge: #ae7f4c39; --accent: #795435; }
  .case-card--twilight { --wash: #cec3dfdd; --edge: #7b699c3a; --accent: #614b79; }

  .case-artwork {
    position: relative;
    aspect-ratio: 570 / 240;
    margin-block: 0.22rem 0.76rem;
    overflow: hidden;
    pointer-events: none;
  }

  /* Crop the shared 800 × 280 artwork to the tighter card framing. */
  .case-artwork img {
    position: absolute;
    inset-block-start: -7.9167%;
    inset-inline-start: -20.1754%;
    inline-size: 140.3509%;
    max-inline-size: none;
    max-width: none;
    block-size: auto;
  }

  h2 {
    overflow-wrap: anywhere;
    font-size: clamp(1.16rem, 2.05vw, 1.79rem);
    line-height: 1.22;
    text-wrap: pretty;
  }

  .case-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .case-status,
  .case-arrow {
    display: flex;
    align-items: end;
    min-block-size: 1.32rem;
    margin: 0;
    color: var(--accent);
  }

  .case-status {
    font-size: 0.82rem;
    letter-spacing: 0.015em;
    line-height: 1.45;
  }

  .case-arrow {
    margin-inline-start: auto;
    font: 400 1.37rem/1 system-ui, sans-serif;
  }

  a.case-card:hover,
  a.case-card:focus-visible {
    border-color: var(--accent);
  }

  a.case-card:focus-visible {
    outline: 2px solid #455687;
    outline-offset: 3px;
  }

  @media (max-width: 960px) {
    .case-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 590px) {
    .mysteries-index { padding-block-start: 3.25rem; }
    .case-grid { grid-template-columns: 1fr; }
    h2 { font-size: clamp(1.35rem, 5vw, 1.8rem); }
  }
</style>
