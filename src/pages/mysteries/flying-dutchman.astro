---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseHeader from "../../components/mysteries/CaseHeader.astro";
import CaseIndex from "../../components/mysteries/CaseIndex.astro";
import LocationSection from "../../components/mysteries/LocationSection.astro";
import TimelineSection from "../../components/mysteries/TimelineSection.astro";

const caseSections = [
  { number: "00", label: "Overview", id: "overview" },
  { number: "01", label: "Location", id: "location" },
  { number: "02", label: "Timeline", id: "timeline" },
] as const;

const timelineEvents = [
  {
    date: "1790",
    title: "The Flying Dutchman Appears in Print",
    description:
      "John MacDonald records sailors claiming to see the Flying Dutchman near the Cape of Good Hope, providing the earliest known surviving printed reference to a legend already circulating at sea.",
  },
  {
    date: "1795",
    title: "The Legend Takes Shape",
    description:
      "A Voyage to New South Wales gives the Flying Dutchman a more developed story, describing a Dutch warship lost off the Cape whose apparition was later seen during another violent storm, before the tale spread among sailors.",
  },
  {
    date: "1803–1813",
    title: "The Dutchman’s Doom Deepens",
    description:
      "John Leyden describes a crew condemned to wander the seas after a terrible crime and pestilence, while Walter Scott later links the phantom ship with murder, piracy and an ominous fate.",
  },
  {
    date: "1821",
    title: "The Legend Finds Its Captain",
    description:
      "John Howison’s Vanderdecken’s Message Home introduces Captain Vanderdecken, who vows to continue battling the winds around the Cape until Judgement Day, giving the legend one of its most enduring forms.",
  },
  {
    date: "1834",
    title: "Love Offers an Escape",
    description:
      "Heinrich Heine’s retelling gives the Dutchman a chance of redemption, allowing him ashore once every seven years to seek a woman whose unwavering love and faithfulness could free him from his curse.",
  },
  {
    date: "1837–1839",
    title: "A Son Searches for the Dutchman",
    description:
      "Frederick Marryat’s The Phantom Ship follows Philip Vanderdecken on a far-reaching voyage to find the spectral ship commanded by his father and discover a way to release him from his curse.",
  },
  {
    date: "1843",
    title: "The Dutchman Takes the Stage",
    description:
      "Richard Wagner’s Der fliegende Holländer premieres in Dresden, transforming the legend into an operatic drama centred on the cursed captain and Senta, whose faithful love offers him redemption.",
  },
  {
    date: "1881",
    title: "A Phantom Ship Appears",
    description:
      "Thirteen people aboard HMS Inconstant, including the future King George V, witness a glowing apparition resembling a brig off south-eastern Australia. Moments later no vessel can be found, while nearby ships also report seeing the strange red light.",
  },
] as const;
---

<BaseLayout
  title="Flying Dutchman | Atlas Aeterna"
  description="Explore the Flying Dutchman, the legendary ghost ship associated with the Cape of Good Hope, and the history and folklore behind its enduring mystery."
>
  <article class="case-page">
    <CaseHeader
      title="Flying Dutchman"
      intro="The Flying Dutchman is one of maritime folklore’s most enduring legends, a phantom ship said to wander the seas without rest, most famously associated with the waters around the Cape of Good Hope."
      titleVariant="long"
    />

    <CaseIndex sections={caseSections} />

    <LocationSection
      alt="World map showing the approximate region around the Cape of Good Hope associated with the Flying Dutchman legend"
      caption="Approximate region associated with the Flying Dutchman legend in the waters around the Cape of Good Hope."
      map={{
        worldWidth: "275%",
        worldLeft: "-90%",
        worldTop: "-120%",
        markerTop: "71.5%",
        markerLeft: "52.3%",
      }}
    />

    <TimelineSection events={timelineEvents} />
  </article>
</BaseLayout>

<style>
  .case-page {
    --case-blue: #84a9ee;
    --case-gold: #d9ad72;
    --case-violet: #a58bd9;

    padding: 18px 0 38px;
  }

  @media (max-width: 650px) {
    .case-page {
      padding-top: 0;
    }
  }
</style>
