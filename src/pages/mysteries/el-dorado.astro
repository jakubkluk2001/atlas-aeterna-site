  <script>
    const caseIndex = document.querySelector("[data-case-index]");

    if (caseIndex instanceof HTMLElement) {
      const scroller = caseIndex.querySelector(".case-index__scroller");

      const links = Array.from(
        caseIndex.querySelectorAll("[data-case-index-link]")
      ).filter((link) => link instanceof HTMLAnchorElement);

      const sections = links
        .map((link) => {
          const id = link.dataset.caseIndexLink;
          return id ? document.getElementById(id) : null;
        })
        .filter((section) => section instanceof HTMLElement);

      let activeId = "";
      let updateFrame = 0;

      const centreActiveLink = (
        link: HTMLAnchorElement,
        behavior: ScrollBehavior
      ) => {
        if (!(scroller instanceof HTMLElement)) return;

        const scrollerRect = scroller.getBoundingClientRect();
        const linkRect = link.getBoundingClientRect();
        const targetLeft =
          scroller.scrollLeft +
          (linkRect.left - scrollerRect.left) -
          (scroller.clientWidth - linkRect.width) / 2;

        scroller.scrollTo({
          left: Math.max(0, targetLeft),
          behavior,
        });
      };

      const setActiveSection = (
        id: string,
        behavior: ScrollBehavior = "smooth"
      ) => {
        if (activeId === id) return;
        activeId = id;

        links.forEach((link) => {
          const isActive = link.dataset.caseIndexLink === id;

          if (isActive) {
            link.setAttribute("aria-current", "location");
            centreActiveLink(link, behavior);
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const getActivationLine = () => {
        const stickyTop = Number.parseFloat(
          window.getComputedStyle(caseIndex).top
        );

        return (Number.isFinite(stickyTop) ? stickyTop : 0) +
          caseIndex.offsetHeight +
          24;
      };

      const updateActiveSection = () => {
        updateFrame = 0;

        if (sections.length === 0) return;

        const activationLine = getActivationLine();
        let currentSection = sections[0];

        for (const section of sections) {
          if (section.getBoundingClientRect().top <= activationLine) {
            currentSection = section;
          } else {
            break;
          }
        }

        const reachedPageEnd =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 4;

        if (reachedPageEnd) {
          currentSection = sections[sections.length - 1];
        }

        if (currentSection instanceof HTMLElement) {
          setActiveSection(currentSection.id);
        }
      };

      const requestActiveSectionUpdate = () => {
        if (updateFrame !== 0) return;
        updateFrame = window.requestAnimationFrame(updateActiveSection);
      };

      links.forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.dataset.caseIndexLink;
          if (id) setActiveSection(id);
        });
      });

      window.addEventListener("scroll", requestActiveSectionUpdate, {
        passive: true,
      });
      window.addEventListener("resize", requestActiveSectionUpdate);
      window.addEventListener("load", requestActiveSectionUpdate);

      updateActiveSection();
    }
  </script>
