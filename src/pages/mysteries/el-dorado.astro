  .theories-list::before {
    content: "";

    width: 2px;

    position: absolute;
    top: 35px;
    bottom: 35px;
    left: 10px;

    background:
      linear-gradient(
        to bottom,
        rgba(199, 149, 80, 0.74) 0%,
