  .timeline-content:hover::before {
    transform: translate(-8px, 9px) scale(1.08);
  }


  .timeline-date {
    margin: 0 0 11px;

    color: #7d94c5;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
