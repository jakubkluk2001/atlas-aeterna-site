---
import BaseLayout from "../../layouts/BaseLayout.astro";

const evidenceStatuses = {
  strong: "Strong Evidence",
  supporting: "Supporting Evidence",
  inconclusive: "Inconclusive",
  disputed: "Disputed",
  against: "Evidence Against",
  unsupported: "Unsupported",
} as const;

type EvidenceFit = "cover" | "contain";
type EvidenceTone = "blue" | "gold" | "violet" | "neutral";
type EvidenceStatusTone = keyof typeof evidenceStatuses;

interface EvidenceItem {
  id: string;
  number: string;
  type: string;
  title: string;
  description: string;
  status: EvidenceStatusTone;
  image: string | null;
  alt: string;
  fit: EvidenceFit;
  tone: EvidenceTone;
  meta: Array<{
    label: string;
    value: string;
  }>;
}

/*
  Evidence visuals use a standard 4:3 frame with `cover` as the default.
  Change an individual item to `contain` only if cropping removes important detail.
  The fallback panel is the finished visual treatment for evidence without an image.

  Available evidence statuses are fixed in `evidenceStatuses` above so every
  mystery uses the same labels. Their colours are defined in the evidence CSS.
*/

const featuredEvidence: EvidenceItem = {
  id: "muisca-raft",
  number: "01",
  type: "Archaeological object",
  title: "The Muisca Raft",
  description:
    "Discovered near Pasca in 1969, the gold-alloy votive object depicts a central figure aboard a raft surrounded by attendants. It gives material form to the ceremonial tradition most closely associated with the origins of El Dorado.",
  status: "strong",
  image: "/images/mysteries/el-dorado/muisca-raft.webp",
  alt: "Gold Muisca votive raft depicting a central figure surrounded by attendants",
  fit: "cover",
  tone: "gold",
  meta: [
    { label: "Discovered", value: "1969" },
    { label: "Found near", value: "Pasca, Colombia" },
    { label: "Form", value: "Gold-alloy votive object" },
  ],
};

const supportingEvidence: EvidenceItem[] = [
  {
    id: "lake-guatavita",
    number: "02",
    type: "Location",
    title: "Lake Guatavita",
    description:
      "Lake Guatavita formed part of a sacred Muisca landscape where ritual offerings were made. The lake supports the ceremonial origin of the legend, but its existence alone does not establish the later story of a hidden golden city.",
    status: "supporting",
    image: "/images/mysteries/el-dorado/lake-guatavita.webp",
    alt: "Aerial view of Lake Guatavita in Colombia",
    fit: "cover",
    tone: "blue",
    meta: [
      { label: "Kind", value: "Sacred location" },
      { label: "Region", value: "Cundinamarca" },
      { label: "Role", value: "Ritual landscape" },
    ],
  },
  {
    id: "votive-offerings",
    number: "03",
    type: "Archaeological finds",
    title: "Muisca Votive Offerings",
    description:
      "Other Muisca votive objects show that the raft was not an isolated piece. Gold-alloy offerings belonged to a wider ceremonial tradition connected with sacred places and acts of deposition.",
    status: "supporting",
    image: "/images/mysteries/el-dorado/muisca-votive-offerings.webp",
    alt: "A group of small Muisca gold-alloy votive figures",
    fit: "cover",
    tone: "gold",
    meta: [
      { label: "Form", value: "Votive objects" },
      { label: "Material", value: "Gold alloy" },
      { label: "Role", value: "Ceremonial offerings" },
    ],
  },
  {
    id: "written-accounts",
    number: "04",
    type: "Historical record",
    title: "The Written Accounts",
    description:
      "Colonial-era accounts preserved stories of a gilded ruler and offerings at a sacred lake. They support the ceremonial tradition behind El Dorado, although their later European retelling means they are contextual rather than decisive evidence.",
    status: "supporting",
    image: "/images/mysteries/el-dorado/written-accounts.webp",
    alt: "Detail from an early historical manuscript associated with accounts of El Dorado",
    fit: "cover",
    tone: "violet",
    meta: [
      { label: "Period", value: "Colonial era" },
      { label: "Form", value: "Written testimony" },
      { label: "Limit", value: "Later retelling" },
    ],
  },
  {
    id: "guatavita-finds",
    number: "05",
    type: "Recovered material",
    title: "Finds from Guatavita",
    description:
      "Searches of Lake Guatavita recovered objects associated with Muisca offering practices, but nothing approaching the immense treasure imagined by later expeditions. The finds support ritual deposition without resolving the legend's larger claims.",
    status: "inconclusive",
    image: "/images/mysteries/el-dorado/finds-from-guatavita.webp",
    alt: "Historic artefacts associated with searches of Lake Guatavita",
    fit: "cover",
    tone: "blue",
    meta: [
      { label: "Result", value: "Offerings recovered" },
      { label: "Supports", value: "Ritual deposition" },
      { label: "Does not show", value: "Legendary treasure" },
    ],
  },
  {
    id: "gilded-chief-ceremony",
    number: "06",
    type: "Historical interpretation",
    title: "The Gilded Chief Ceremony",
    description:
      "The famous image of a newly invested ruler covered in gold dust and entering the lake comes principally through colonial accounts. It may preserve an older Muisca tradition, but the ceremony's exact form and details cannot be independently confirmed.",
    status: "disputed",
    image: "/images/mysteries/el-dorado/gilded-chief-ceremony.webp",
    alt: "Historical depiction of the gilded chief ceremony associated with El Dorado",
    fit: "cover",
    tone: "gold",
    meta: [
      { label: "Source", value: "Colonial accounts" },
      { label: "Claim", value: "Gilded ruler ritual" },
      { label: "Limit", value: "Exact form uncertain" },
    ],
  },
  {
    id: "lake-parime-manoa",
    number: "07",
    type: "Cartographic claim",
    title: "Lake Parime & Manoa",
    description:
      "European maps placed Manoa beside a vast Lake Parime in Guiana, turning El Dorado into a fixed geographical destination. Later exploration failed to confirm that landscape as mapped, weakening this eastern golden-city version of the legend.",
    status: "against",
    image: "/images/mysteries/el-dorado/lake-parime-manoa.webp",
    alt: "Historical map showing Lake Parime and the supposed city of Manoa",
    fit: "cover",
    tone: "violet",
    meta: [
      { label: "Region", value: "Guiana" },
      { label: "Claim", value: "Manoa by Lake Parime" },
      { label: "Outcome", value: "Geography not confirmed" },
    ],
  },
  {
    id: "golden-city",
    number: "08",
    type: "Absence of evidence",
    title: "The Golden City",
    description:
      "No archaeological discovery has established the vast golden city or kingdom later pursued across South America. This is where the surviving evidence ends and the expanded European legend begins.",
    status: "unsupported",
    image: null,
    alt: "",
    fit: "cover",
    tone: "neutral",
    meta: [
      { label: "Claim", value: "Golden city or kingdom" },
      { label: "Archaeology", value: "Not established" },
      { label: "Role", value: "Later legendary expansion" },
    ],
  },
];
const theoryStatuses = {
  leading: "Leading Interpretation",
  possibility: "Open Possibility",
  legend: "The Legend",
} as const;

type TheoryStatusTone = keyof typeof theoryStatuses;
type TheoryTone = "grounded" | "open" | "legendary";

interface TheoryReference {
  label: string;
  title: string;
  href: string;
}

interface TheoryItem {
  id: string;
  number: string;
  category: string;
  title: string;
  statement: string;
  summary: string;
  status: TheoryStatusTone;
  tone: TheoryTone;
  evidence: TheoryReference[];
  details: Array<{
    label: string;
    value: string;
  }>;
}

/*
  Working Theories is intentionally variable-length. Other mystery pages can
  include as many genuinely distinct interpretations as the case supports,
  while keeping the same hierarchy, status language and internal anatomy.
*/

const workingTheories: TheoryItem[] = [
  {
    id: "muisca-origin",
    number: "01",
    category: "Most likely theory",
    title: "The Muisca Origin",
    statement:
      "El Dorado most likely grew from real Muisca ritual traditions, gold offerings and the material wealth Europeans encountered among Indigenous societies in northern South America.",
    summary:
      "The strongest reconstruction does not require a lost city. Sacred waters, votive metalwork and elite ceremony formed a genuine cultural setting; colonial reports appear to have compressed and enlarged those elements into the gilded chief and, eventually, a kingdom of gold.",
    status: "leading",
    tone: "grounded",
    evidence: [
      {
        label: "E01",
        title: "The Muisca Raft",
        href: "#evidence-title-muisca-raft",
      },
      {
        label: "E02",
        title: "Lake Guatavita",
        href: "#evidence-title-lake-guatavita",
      },
      {
        label: "E03",
        title: "Muisca Votive Offerings",
        href: "#evidence-title-votive-offerings",
      },
      {
        label: "E04",
        title: "The Written Accounts",
        href: "#evidence-title-written-accounts",
      },
      {
        label: "E05",
        title: "Finds from Guatavita",
        href: "#evidence-title-guatavita-finds",
      },
      {
        label: "E06",
        title: "The Gilded Chief Ceremony",
        href: "#evidence-title-gilded-chief-ceremony",
      },
    ],
    details: [
      {
        label: "Grounded in",
        value:
          "Muisca votive metalwork, offerings at sacred places and ritual activity around Guatavita",
      },
      {
        label: "Best explains",
        value:
          "Why gold, a lake and a powerful ruler sit at the earliest centre of the story",
      },
      {
        label: "Still uncertain",
        value:
          "Whether the famous gilded-ruler ceremony occurred exactly as later writers described it",
      },
    ],
  },
  {
    id: "hidden-kingdom",
    number: "02",
    category: "Historical possibility",
    title: "The Hidden Kingdom",
    statement:
      "Some later reports may have preserved distorted knowledge of a real, wealthy and politically organised society that explorers never successfully identified.",
    summary:
      "The belief itself was historically genuine: expeditions repeatedly followed accounts of powerful inland peoples and rich territories. This interpretation allows a real polity behind part of the later El Dorado tradition, while treating its scale and gold as exaggeration.",
    status: "possibility",
    tone: "open",
    evidence: [
      {
        label: "E04",
        title: "The Written Accounts",
        href: "#evidence-title-written-accounts",
      },
      {
        label: "E07",
        title: "Lake Parime & Manoa",
        href: "#evidence-title-lake-parime-manoa",
      },
      {
        label: "E08",
        title: "The Golden City",
        href: "#evidence-title-golden-city",
      },
    ],
    details: [
      {
        label: "Historical backing",
        value:
          "Accounts, expeditions and maps show that explorers believed the reports pointed to a wealthy inland kingdom",
      },
      {
        label: "What it proposes",
        value:
          "One real society lay behind some later rumours, but was never correctly located or recognised",
      },
      {
        label: "Current limit",
        value:
          "No specific settlement or kingdom has been shown to be the source of those reports",
      },
    ],
  },
  {
    id: "golden-city-theory",
    number: "03",
    category: "Legendary interpretation",
    title: "The Golden City",
    statement:
      "The extraordinary hidden city, kingdom or empire sought by generations of explorers existed substantially as they imagined it and remains undiscovered.",
    summary:
      "This is the defining popular form of El Dorado. It drove expeditions and appeared on European maps, but no confirmed archaeological discovery has established the immense golden centre described by later seekers.",
    status: "legend",
    tone: "legendary",
    evidence: [
      {
        label: "E07",
        title: "Lake Parime & Manoa",
        href: "#evidence-title-lake-parime-manoa",
      },
      {
        label: "E08",
        title: "The Golden City",
        href: "#evidence-title-golden-city",
      },
    ],
    details: [
      {
        label: "Historical belief",
        value:
          "Well attested in accounts, expeditions and the Manoa–Lake Parime map tradition",
      },
      {
        label: "Archaeological support",
        value: "None confirmed",
      },
      {
        label: "Place in the case",
        value:
          "The legend itself rather than the leading historical explanation",
      },
    ],
  },
];

---

<BaseLayout
  title="El Dorado | Atlas Aeterna"
  description="Explore the legend of El Dorado, its location and the history of the search for the legendary source of extraordinary wealth."
>
  <article class="case-page">
    <!-- -------------------------------- -->
    <!-- CASE HEADER                      -->
    <!-- -------------------------------- -->

    <section class="case-header">
      <svg
        class="header-contours"
        viewBox="0 0 620 620"
        fill="none"
        aria-hidden="true"
      >
        <path d="M-36 448C42 357 98 386 158 314C216 245 221 157 318 112C414 67 499 107 656 -14" />
        <path d="M-18 485C63 396 128 418 190 346C254 270 263 188 354 143C450 96 529 131 651 39" />
        <path d="M7 523C85 446 159 453 224 384C294 311 304 225 390 182C476 139 548 155 644 95" />
        <path d="M48 562C124 504 189 499 260 432C334 363 349 284 426 241C500 200 562 204 637 164" />
        <path d="M114 601C187 549 246 544 314 485C383 423 400 347 468 304C530 265 582 264 637 241" />
      </svg>

      <div class="case-object" aria-hidden="true">
        <span class="case-object__orbit case-object__orbit--outer"></span>
        <span class="case-object__orbit case-object__orbit--middle"></span>
        <span class="case-object__orbit case-object__orbit--inner"></span>
        <span class="case-object__axis"></span>

        <span class="case-object__sphere">
          <span class="case-object__latitude case-object__latitude--one"></span>
          <span class="case-object__latitude case-object__latitude--two"></span>
          <span class="case-object__meridian"></span>
        </span>

        <span class="case-object__node case-object__node--one"></span>
        <span class="case-object__node case-object__node--two"></span>
      </div>

      <div class="case-header__content">
        <h1>El Dorado</h1>

        <p class="case-intro">
          El Dorado is one of history’s most enduring legends, a 
          tale of gold, discovery and a hidden land of extraordinary 
          wealth somewhere in the vast landscapes of South America.
        </p>
      </div>

      <span class="edge-mark edge-mark--top-left" aria-hidden="true"></span>
      <span class="edge-mark edge-mark--top-right" aria-hidden="true"></span>
      <span class="edge-mark edge-mark--bottom-left" aria-hidden="true"></span>
      <span class="edge-mark edge-mark--bottom-right" aria-hidden="true"></span>
    </section>


    <!-- -------------------------------- -->
    <!-- LOCATION                         -->
    <!-- -------------------------------- -->

    <section class="content-section map-section">
      <div class="section-heading">
        <span class="section-number" aria-hidden="true">01</span>
        <h2>Location</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>

      <figure class="map-card">
        <div class="map-viewport">
          <span class="map-grid" aria-hidden="true"></span>
          <span class="map-compass" aria-hidden="true"></span>

          <div class="map-world">
            <img
              class="map-image"
              src="/blank-map-world.svg"
              alt="World map showing the approximate region associated with El Dorado"
              loading="eager"
            />

            <div
              class="map-marker"
              aria-hidden="true"
            >
              <span class="marker-area"></span>
              <span class="marker-core"></span>
            </div>
          </div>
        </div>

        <figcaption class="map-caption">
          Approximate region associated with the origins of the El Dorado legend in present-day Colombia.
        </figcaption>
      </figure>
    </section>


    <!-- -------------------------------- -->
    <!-- TIMELINE                         -->
    <!-- -------------------------------- -->

    <section class="content-section timeline-section">
      <div class="section-heading">
        <span class="section-number" aria-hidden="true">02</span>
        <h2>Timeline</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>

      <div class="timeline-shell">
        <div class="timeline">
          <!-- EVENT 1 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                Before European Contact
              </p>

              <h3>The Sacred Lake</h3>

              <p>
                Lake Guatavita formed part of a sacred Muisca landscape where ritual offerings were made, traditions that would 
                later become closely connected with the legend of El Dorado.
              </p>
            </div>
          </article>


          <!-- EVENT 2 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1537
              </p>

              <h3>The Spanish Encounter the Muisca</h3>

              <p>
                Gonzalo Jiménez de Quesada and his expedition enter Muisca territory, beginning Spanish contact with the 
                culture and region that would become central to the El Dorado legend.
              </p>
            </div>
          </article>


          <!-- EVENT 3 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1562
              </p>

              <h3>The Search Turns to Guatavita</h3>

              <p>
                Antonio de Sepúlveda receives royal permission to recover the riches believed to lie beneath Lake Guatavita, 
                beginning an ambitious effort to uncover its hidden offerings.
              </p>
            </div>
          </article>


          <!-- EVENT 4 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1590–1595
              </p>

              <h3>The Legend Moves East</h3>

              <p>
                Spanish expeditions push the search for El Dorado into Guiana and the Orinoco, where the legend becomes 
                increasingly associated with Manoa, a great city or kingdom of extraordinary wealth.
              </p>
            </div>
          </article>


          <!-- EVENT 5 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1595–1618
              </p>

              <h3>Raleigh’s Search for El Dorado</h3>

              <p>
                Walter Raleigh leads two expeditions into Guiana in pursuit of El Dorado, exploring the Orinoco and searching for 
                the great golden city of Manoa. His final expedition ends in disaster.
              </p>
            </div>
          </article>


          <!-- EVENT 6 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1911–1912
              </p>

              <h3>Guatavita Is Drained</h3>

              <p>
                An ambitious British operation lowers the lake in search of its legendary treasure, revealing the difficult mud-
                covered floor beneath the waters.
              </p>
            </div>
          </article>


          <!-- EVENT 7 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                1969
              </p>

              <h3>A Legend Cast in Gold</h3>

              <p>
                A remarkable gold raft is discovered in a cave near Pasca, Cundinamarca. The Muisca votive piece depicts a 
                ceremonial scene closely associated with the traditions surrounding El Dorado.
              </p>
            </div>
          </article>


          <!-- EVENT 8 -->

          <article class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>

            <div class="timeline-content">
              <p class="timeline-date">
                2009
              </p>

              <h3>Archaeology Returns to Guatavita</h3>

              <p>
                An archaeological survey around Lake Guatavita uncovers evidence of a Muisca shrine and ritual offerings, 
                revealing more about the sacred landscape at the heart of the El Dorado legend.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>


    <!-- -------------------------------- -->
    <!-- EVIDENCE                         -->
    <!-- -------------------------------- -->

    <section class="content-section evidence-section">
      <div class="section-heading">
        <span class="section-number" aria-hidden="true">03</span>
        <h2>Evidence</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>

      <div class="evidence-shell">
        <header class="evidence-overview">
          <div class="evidence-overview__intro">
            <p class="evidence-overline">The surviving record</p>
            <h3>One defining artefact behind a larger legend</h3>
          </div>

          <div class="evidence-overview__aside">
            <p class="evidence-summary">
              The Muisca Raft is the strongest surviving material link between El Dorado and a real ceremonial tradition. The surrounding evidence supports that origin, while the later golden-city story becomes increasingly uncertain.
            </p>
          </div>
        </header>

        <article
          class="evidence-featured"
          aria-labelledby={`evidence-title-${featuredEvidence.id}`}
        >
          <div
            class:list={[
              "evidence-visual",
              "evidence-visual--featured",
              `evidence-visual--${featuredEvidence.tone}`,
            ]}
          >
            {featuredEvidence.image ? (
              <img
                class:list={[
                  "evidence-image",
                  `evidence-image--${featuredEvidence.fit}`,
                ]}
                src={featuredEvidence.image}
                alt={featuredEvidence.alt}
                loading="lazy"
              />
            ) : (
              <div class="evidence-visual__fallback" aria-hidden="true">
                <span class="evidence-visual__grid"></span>
                <span class="evidence-visual__ring evidence-visual__ring--one"></span>
                <span class="evidence-visual__ring evidence-visual__ring--two"></span>
                <span class="evidence-visual__fallback-number">{featuredEvidence.number}</span>
                <span class="evidence-visual__fallback-type">{featuredEvidence.type}</span>
              </div>
            )}
          </div>

          <div class="evidence-featured__content">
            <div class="evidence-label-row">
              <p class="evidence-label">
                <span>{featuredEvidence.number}</span>
                <span class="evidence-label__rule" aria-hidden="true"></span>
                {featuredEvidence.type}
              </p>

              <span
                class:list={[
                  "evidence-status",
                  `evidence-status--${featuredEvidence.status}`,
                ]}
              >
                {evidenceStatuses[featuredEvidence.status]}
              </span>
            </div>

            <h3 id={`evidence-title-${featuredEvidence.id}`}>
              {featuredEvidence.title}
            </h3>

            <p class="evidence-description">
              {featuredEvidence.description}
            </p>

            <dl class="evidence-meta evidence-meta--featured">
              {featuredEvidence.meta.map((entry) => (
                <div>
                  <dt>{entry.label}</dt>
                  <dd>{entry.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>

        <div class="evidence-grid">
          {supportingEvidence.map((item) => (
            <article
              class="evidence-card"
              aria-labelledby={`evidence-title-${item.id}`}
            >
              <div
                class:list={[
                  "evidence-visual",
                  `evidence-visual--${item.tone}`,
                ]}
              >
                {item.image ? (
                  <img
                    class:list={[
                      "evidence-image",
                      `evidence-image--${item.fit}`,
                    ]}
                    src={item.image}
                    alt={item.alt}
                    loading="lazy"
                  />
                ) : (
                  <div class="evidence-visual__fallback" aria-hidden="true">
                    <span class="evidence-visual__grid"></span>
                    <span class="evidence-visual__ring evidence-visual__ring--one"></span>
                    <span class="evidence-visual__ring evidence-visual__ring--two"></span>
                    <span class="evidence-visual__fallback-number">{item.number}</span>
                    <span class="evidence-visual__fallback-type">{item.type}</span>
                  </div>
                )}
              </div>

              <div class="evidence-card__body">
                <div class="evidence-label-row">
                  <p class="evidence-label">
                    <span>{item.number}</span>
                    <span class="evidence-label__rule" aria-hidden="true"></span>
                    {item.type}
                  </p>

                  <span
                    class:list={[
                      "evidence-status",
                      `evidence-status--${item.status}`,
                    ]}
                  >
                    {evidenceStatuses[item.status]}
                  </span>
                </div>

                <h3 id={`evidence-title-${item.id}`}>{item.title}</h3>

                <p class="evidence-description">
                  {item.description}
                </p>

                <dl class="evidence-meta evidence-meta--card">
                  {item.meta.map((entry) => (
                    <div>
                      <dt>{entry.label}</dt>
                      <dd>{entry.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- -------------------------------- -->
    <!-- WORKING THEORIES                 -->
    <!-- -------------------------------- -->

    <section class="content-section theories-section">
      <div class="section-heading">
        <span class="section-number" aria-hidden="true">04</span>
        <h2>Working Theories</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>

      <div class="theories-shell">
        <header class="theories-overview">
          <div class="theories-overview__intro">
            <p class="theories-overline">Interpreting the record</p>
            <h3>What was El Dorado?</h3>
          </div>

          <div class="theories-overview__aside">
            <p class="theories-summary">
              These interpretations are not equally supported. The first is the leading historical reconstruction, the second is an open possibility within the later reports, and the third is the legend in its fullest form.
            </p>
          </div>
        </header>

        <div class="theories-list">
          {workingTheories.map((theory) => (
            <div
              class:list={[
                "theory-step",
                `theory-step--${theory.tone}`,
              ]}
            >
              <span class="theory-step__marker" aria-hidden="true"></span>

              <article
                class="theory-card"
                data-number={theory.number}
                aria-labelledby={`theory-title-${theory.id}`}
              >
                <div class="theory-card__header">
                  <p class="theory-label">
                    <span>{theory.number}</span>
                    <span class="theory-label__rule" aria-hidden="true"></span>
                    {theory.category}
                  </p>

                  <span
                    class:list={[
                      "theory-status",
                      `theory-status--${theory.status}`,
                    ]}
                  >
                    {theoryStatuses[theory.status]}
                  </span>
                </div>

                <div class="theory-card__layout">
                  <div class="theory-card__statement">
                    <h3 id={`theory-title-${theory.id}`}>
                      {theory.title}
                    </h3>

                    <p class="theory-thesis">
                      {theory.statement}
                    </p>

                    <div class="theory-evidence">
                      <p>Evidence in this file</p>

                      <div
                        class="theory-evidence__list"
                        aria-label={`Evidence entries related to ${theory.title}`}
                      >
                        {theory.evidence.map((reference) => (
                          <a
                            href={reference.href}
                            title={reference.title}
                            aria-label={`${reference.label}: ${reference.title}`}
                          >
                            {reference.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="theory-card__analysis">
                    <p class="theory-copy">
                      {theory.summary}
                    </p>

                    <dl class="theory-details">
                      {theory.details.map((detail) => (
                        <div>
                          <dt>{detail.label}</dt>
                          <dd>{detail.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

  </article>
</BaseLayout>


