  }


  .theory-details {
    margin: clamp(24px, 3vw, 34px) 0 0;
    padding: 0;

    border-top: 1px solid rgba(65, 75, 99, 0.10);
  }


  .theory-details div {
    display: grid;
    grid-template-columns: minmax(112px, 0.72fr) minmax(0, 1.28fr);
    align-items: baseline;

    gap: 17px;

    padding: 13px 0;

    border-bottom: 1px solid rgba(65, 75, 99, 0.065);
  }


  .theory-details div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }


  .theory-details dt {
    color: #9298a5;

    font-family: var(--font-ui);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .theory-details dd {
    margin: 0;

    color: #4d5361;

    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.65;
    text-align: right;
  }


  .evidence-featured__content h3,
  .evidence-card h3 {
    scroll-margin-top: 158px;
  }


  @media (max-width: 820px) {
    .theories-overview,
    .theory-card__layout,
    .theory-step--grounded .theory-card__layout {
      grid-template-columns: 1fr;
    }

    .theory-card__layout {
      gap: 28px;
    }
  }


  @media (max-width: 650px) {
    .theories-shell {
      padding: 22px 15px;

      border-radius: 24px;
    }

    .theories-overview {
      gap: 18px;

      padding:
        1px
        3px
        25px;
    }

    .theories-overview h3 {
      font-size: 26px;
    }

    .theories-summary {
      font-size: 13px;
    }

    .theories-list {
      padding-left: 35px;

      gap: 15px;
    }

    .theories-list::before {
      left: 6px;
    }

    .theory-card,
    .theory-step--grounded .theory-card {
      padding: 22px 18px;

      border-radius: 22px;
    }

    .theory-step__marker {
      width: 15px;

      top: 27px;
      left: -36px;

      box-shadow:
        0 0 0 4px var(--theory-accent-faint),
        0 7px 15px rgba(69, 79, 105, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 1);
    }

    .theory-card::after {
      right: 12px;
      bottom: -15px;

      font-size: 84px;
    }

    .theory-card__layout {
      margin-top: 21px;
      gap: 24px;
    }

    .theory-card h3,
    .theory-step--grounded h3 {
      font-size: 30px;
    }

    .theory-thesis,
    .theory-step--grounded .theory-thesis {
      margin-top: 13px;

      font-size: 15px;
      line-height: 1.72;
    }

    .theory-copy {
      font-size: 13px;
    }

    .theory-details div {
      grid-template-columns: 1fr;

      gap: 5px;
    }

    .theory-details dd {
      text-align: left;
    }
  }


  /* ---------------------------------- */
  /* THE SEARCH                         */
  /* ---------------------------------- */

  .search-section {
    padding-bottom: 22px;
  }


  .search-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 7% 5%,
        rgba(116, 166, 235, 0.14),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 6%,
        rgba(218, 167, 99, 0.15),
        transparent 31%
      ),
      radial-gradient(
        circle at 89% 96%,
        rgba(165, 139, 217, 0.12),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.49)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .search-shell::before {
    content: "";

    width: 460px;
    aspect-ratio: 1;

    position: absolute;
    right: -275px;
    top: 148px;
    z-index: -1;

    border: 1px solid rgba(75, 84, 106, 0.095);
    border-radius: 50%;

    box-shadow:
      0 0 0 58px rgba(255, 255, 255, 0.045),
      0 0 0 116px rgba(75, 84, 106, 0.020);

    pointer-events: none;
  }


  .search-overview {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(310px, 0.82fr);
    align-items: end;

    gap: clamp(24px, 4vw, 56px);

    padding:
      2px
      4px
      clamp(26px, 3.5vw, 38px);

    border-bottom: 1px solid rgba(66, 76, 99, 0.10);
  }


  .search-overline,
  .search-dashboard__overline {
    margin: 0 0 10px;

    color: #7c7595;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  .search-overview h3 {
    max-width: 650px;

    margin: 0;

    color: #1d2029;

    font-size: clamp(25px, 3.1vw, 38px);
    line-height: 1.25;
  }


  .search-overview__aside {
    min-width: 0;
  }


  .search-summary {
    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.80;
  }


  .search-dashboard {
    position: relative;
    z-index: 1;

    margin-top: clamp(25px, 3.5vw, 38px);
    padding: clamp(18px, 2.7vw, 28px);

    display: grid;
    grid-template-columns:
      minmax(275px, 0.72fr)
      minmax(0, 1.28fr);
    align-items: stretch;

    gap: clamp(22px, 3.5vw, 40px);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.82),
        rgba(247, 248, 252, 0.55)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(22px, 2.5vw, 30px);

    box-shadow:
      0 18px 42px rgba(50, 62, 88, 0.086),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .search-dashboard__brief {
    min-width: 0;

    padding:
      clamp(8px, 1.5vw, 15px)
      0
      clamp(6px, 1vw, 10px)
      clamp(3px, 0.7vw, 7px);

    display: flex;
    flex-direction: column;
  }


  .search-dashboard__overline {
    color: #92784f;
  }


  .search-dashboard__brief h3 {
    margin: 0;

    color: #1d2029;

    font-size: clamp(27px, 3.4vw, 40px);
    line-height: 1.20;
  }


  .search-dashboard__copy {
    margin: 17px 0 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.82;
  }


  .search-stats {
    margin: auto 0 0;
    padding: clamp(23px, 3vw, 32px) 0 0;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));

    border-top: 1px solid rgba(65, 75, 99, 0.10);
  }


  .search-stats div {
    min-width: 0;

    padding: 0 13px;

    border-left: 1px solid rgba(65, 75, 99, 0.085);
  }


  .search-stats div:first-child {
    padding-left: 0;
    border-left: 0;
  }


  .search-stats div:last-child {
    padding-right: 0;
  }


  .search-stats dt {
    color: #9298a5;

    font-family: var(--font-ui);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .search-stats dd {
    margin: 7px 0 0;

    color: #444a58;

    font-family: var(--font-display);
    font-size: clamp(22px, 2.7vw, 31px);
    line-height: 1;
  }


  .search-plot-frame {
    min-width: 0;

    margin: 0;

    display: flex;
    flex-direction: column;

    gap: 11px;
  }


  .search-plot {
    min-height: 338px;

    position: relative;
    isolation: isolate;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 17% 78%,
        rgba(218, 167, 99, 0.15),
        transparent 27%
      ),
      radial-gradient(
        circle at 78% 24%,
        rgba(116, 166, 235, 0.15),
        transparent 31%
      ),
      linear-gradient(
        145deg,
        rgba(237, 242, 250, 0.86),
        rgba(248, 246, 243, 0.76)
      );

    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: clamp(18px, 2vw, 24px);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 0 46px rgba(82, 96, 127, 0.055);
  }


  .search-plot::after {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 5;

    background:
      linear-gradient(
        116deg,
        rgba(255, 255, 255, 0.42),
        transparent 23%,
        transparent 73%,
        rgba(255, 255, 255, 0.15)
      );

    pointer-events: none;
  }


  .search-plot__grid {
    position: absolute;
    inset: 0;
    z-index: 0;

    display: block;

    opacity: 0.20;

    background-image:
      linear-gradient(
        rgba(65, 76, 102, 0.13) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(65, 76, 102, 0.13) 1px,
        transparent 1px
      );

    background-size: 42px 42px;

    mask-image:
      radial-gradient(
        circle at 50% 50%,
        black,
        transparent 82%
      );

    -webkit-mask-image:
      radial-gradient(
        circle at 50% 50%,
        black,
        transparent 82%
      );

    pointer-events: none;
  }


  .search-plot__routes {
    width: 100%;
    height: 100%;

    position: absolute;
    inset: 0;
    z-index: 1;

    overflow: visible;

    pointer-events: none;
  }


  .search-plot__contour {
    fill: none;
    stroke: rgba(78, 86, 106, 0.10);
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }


  .search-plot__contour--two {
    opacity: 0.75;
  }


  .search-plot__contour--three {
    opacity: 0.58;
  }


  .search-plot__route-glow,
  .search-plot__route {
    fill: none;
    vector-effect: non-scaling-stroke;
  }


  .search-plot__route-glow {
    stroke: rgba(119, 143, 193, 0.13);
    stroke-width: 8;
    filter: blur(3px);
  }


  .search-plot__route {
    stroke: rgba(104, 122, 160, 0.42);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 5 6;
  }


  .search-plot__region {
    position: absolute;
    z-index: 1;

    color: rgba(62, 69, 86, 0.20);

    font-family: var(--font-ui);
    font-size: 7px;
    font-weight: 750;
    letter-spacing: 0.17em;
    text-transform: uppercase;

    pointer-events: none;
  }


  .search-plot__region--west {
    left: 5%;
    top: 10%;
  }


  .search-plot__region--centre {
    left: 39%;
    bottom: 9%;
  }


  .search-plot__region--east {
    right: 5%;
    top: 9%;
  }


  .search-plot__node {
    --search-node-accent: #858b99;
    --search-node-rgb: 133, 139, 153;

    position: absolute;
    left: var(--node-x);
    top: var(--node-y);
    z-index: 4;

    color: #4f5664;

    text-decoration: none;

    transform: translate(-50%, -50%);
  }


  .search-plot__point {
    width: 27px;
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    color: var(--search-node-accent);
    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(var(--search-node-rgb), 0.24) 48%,
        rgba(var(--search-node-rgb), 0.54)
      );

    border: 1px solid rgba(255, 255, 255, 0.96);
    border-radius: 50%;

    box-shadow:
      0 0 0 6px rgba(var(--search-node-rgb), 0.065),
      0 9px 19px rgba(62, 75, 105, 0.17),
      inset 0 1px 0 white;

    font-family: var(--font-ui);
    font-size: 6px;
    font-weight: 800;
    letter-spacing: 0.05em;

    transition:
      transform 0.24s var(--ease-out),
      box-shadow 0.24s ease;
  }


  .search-plot__label {
    width: max-content;
    max-width: 126px;

    position: absolute;

    display: flex;
    flex-direction: column;

    gap: 3px;

    pointer-events: none;
  }


  .search-plot__label strong {
    color: #3f4552;

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.055em;
    line-height: 1.25;
  }


  .search-plot__label span {
    color: #9298a5;

    font-family: var(--font-ui);
    font-size: 7px;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.3;
  }


  .search-plot__node--above .search-plot__label {
    left: 50%;
    bottom: calc(100% + 13px);

    text-align: center;

    transform: translateX(-50%);
  }


  .search-plot__node--below .search-plot__label {
    left: 50%;
    top: calc(100% + 13px);

    text-align: center;

    transform: translateX(-50%);
  }


  .search-plot__node--left .search-plot__label {
    right: calc(100% + 13px);
    top: 50%;

    text-align: right;

    transform: translateY(-50%);
  }


  .search-plot__node--right .search-plot__label {
    left: calc(100% + 13px);
    top: 50%;

    text-align: left;

    transform: translateY(-50%);
  }


  .search-plot__node:hover .search-plot__point,
  .search-plot__node:focus-visible .search-plot__point {
    transform: scale(1.08);

    box-shadow:
      0 0 0 8px rgba(var(--search-node-rgb), 0.085),
      0 12px 23px rgba(62, 75, 105, 0.20),
      inset 0 1px 0 white;
  }


  .search-plot__node--gold {
    --search-node-accent: #a9793d;
    --search-node-rgb: 190, 143, 80;
  }


  .search-plot__node--blue {
    --search-node-accent: #6383bb;
    --search-node-rgb: 104, 140, 201;
  }


  .search-plot__node--violet {
    --search-node-accent: #8069a6;
    --search-node-rgb: 143, 116, 184;
  }


  .search-plot__node--neutral {
    --search-node-accent: #737a87;
    --search-node-rgb: 125, 132, 146;
  }


  .search-plot-frame figcaption {
    margin: 0;

    color: #949aa6;

    font-family: var(--font-ui);
    font-size: 9px;
    line-height: 1.55;
    text-align: center;
  }


  .search-records__heading {
    position: relative;
    z-index: 1;

    margin-top: clamp(30px, 4vw, 46px);
    padding: 0 4px 15px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;

    gap: 8px 18px;

    border-bottom: 1px solid rgba(65, 75, 99, 0.11);
  }


  .search-records__heading p,
  .search-records__heading span {
    margin: 0;

    font-family: var(--font-ui);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .search-records__heading p {
    color: #6d7482;
  }


  .search-records__heading span {
    color: #9aa0ac;
  }


  .search-records {
    position: relative;
    z-index: 1;
  }


  .search-record {
    --search-accent: #858b99;
    --search-accent-rgb: 133, 139, 153;
    --search-accent-soft: rgba(133, 139, 153, 0.075);

    min-width: 0;

    position: relative;

    padding:
      clamp(27px, 3.7vw, 42px)
      4px;

    display: grid;
    grid-template-columns:
      minmax(105px, 0.34fr)
      minmax(0, 0.92fr)
      minmax(330px, 1.08fr);
    align-items: start;

    gap: clamp(24px, 4vw, 52px);

    border-bottom: 1px solid rgba(65, 75, 99, 0.095);

    scroll-margin-top: 158px;
  }


  .search-record:last-child {
    padding-bottom: 2px;
    border-bottom: 0;
  }


  .search-record::before {
    content: "";

    position: absolute;
    inset: 9px -12px;
    z-index: -1;

    background:
      radial-gradient(
        circle at 94% 8%,
        var(--search-accent-soft),
        transparent 31%
      );

    border-radius: 25px;

    opacity: 0;

    transition: opacity 0.28s ease;
  }


  .search-record:hover::before {
    opacity: 1;
  }


  .search-record--gold {
    --search-accent: #a9783e;
    --search-accent-rgb: 190, 142, 78;
    --search-accent-soft: rgba(211, 162, 94, 0.10);
  }


  .search-record--blue {
    --search-accent: #6483ba;
    --search-accent-rgb: 100, 131, 186;
    --search-accent-soft: rgba(105, 145, 209, 0.09);
  }


  .search-record--violet {
    --search-accent: #826ca6;
    --search-accent-rgb: 130, 108, 166;
    --search-accent-soft: rgba(152, 126, 194, 0.09);
  }


  .search-record--neutral {
    --search-accent: #747b88;
    --search-accent-rgb: 116, 123, 136;
    --search-accent-soft: rgba(116, 123, 136, 0.075);
  }


  .search-record__index,
  .search-record__story,
  .search-record__report {
    min-width: 0;
  }


  .search-record__index {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 10px;
  }


  .search-record__number {
    color: rgba(var(--search-accent-rgb), 0.75);

    font-family: var(--font-display);
    font-size: clamp(39px, 4.8vw, 56px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }


  .search-record__date {
    margin: 0;

    color: #7c8391;

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.10em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .search-status {
    --status-color: #606775;
    --status-background: rgba(255, 255, 255, 0.52);
    --status-border: rgba(255, 255, 255, 0.82);
    --status-dot: #9aa0ad;
    --status-glow: rgba(154, 160, 173, 0.10);

    display: inline-flex;
    align-items: center;

    gap: 7px;

    padding: 7px 9px;

    color: var(--status-color);
    background: var(--status-background);

    border: 1px solid var(--status-border);
    border-radius: 999px;

    box-shadow:
      0 6px 14px rgba(52, 62, 85, 0.055),
      inset 0 1px 0 rgba(255, 255, 255, 0.86);

    font-family: var(--font-ui);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.085em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }


  .search-status::before {
    content: "";

    width: 6px;
    aspect-ratio: 1;

    display: block;

    background: var(--status-dot);
    border-radius: 50%;

    box-shadow: 0 0 0 3px var(--status-glow);
  }


  .search-status--partial {
    --status-color: #8d6738;
    --status-background: rgba(210, 163, 96, 0.11);
    --status-border: rgba(199, 145, 76, 0.19);
    --status-dot: #b88344;
    --status-glow: rgba(184, 131, 68, 0.13);
  }


  .search-status--abandoned {
    --status-color: #94615d;
    --status-background: rgba(190, 116, 108, 0.10);
    --status-border: rgba(184, 111, 103, 0.17);
    --status-dot: #b27068;
    --status-glow: rgba(178, 112, 104, 0.12);
  }


  .search-status--no-discovery {
    --status-color: #666d79;
    --status-background: rgba(116, 124, 139, 0.085);
    --status-border: rgba(116, 124, 139, 0.15);
    --status-dot: #7c8491;
    --status-glow: rgba(124, 132, 145, 0.11);
  }


  .search-status--disputed {
    --status-color: #7f68a0;
    --status-background: rgba(154, 126, 197, 0.10);
    --status-border: rgba(154, 126, 197, 0.18);
    --status-dot: #9277bb;
    --status-glow: rgba(146, 119, 187, 0.13);
  }


  .search-status--successful {
    --status-color: #4f796b;
    --status-background: rgba(99, 154, 134, 0.105);
    --status-border: rgba(99, 154, 134, 0.18);
    --status-dot: #659886;
    --status-glow: rgba(101, 152, 134, 0.13);
  }


  .search-status--ongoing {
    --status-color: #5578b8;
    --status-background: rgba(111, 151, 220, 0.11);
    --status-border: rgba(111, 151, 220, 0.19);
    --status-dot: #668bd0;
    --status-glow: rgba(102, 139, 208, 0.13);
  }


  .search-record__context {
    margin: 0 0 11px;

    color: var(--search-accent);

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.55;
    text-transform: uppercase;
  }


  .search-record__story h3 {
    margin: 0;

    color: #1e212b;

    font-size: clamp(27px, 3.4vw, 40px);
    line-height: 1.18;
  }


  .search-record__description {
    margin: 16px 0 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.84;
  }


  .search-record__report {
    padding: clamp(18px, 2.4vw, 25px);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.68),
        rgba(245, 247, 251, 0.47)
      );

    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 21px;

    box-shadow:
      0 11px 28px rgba(50, 62, 88, 0.058),
      inset 0 1px 0 rgba(255, 255, 255, 0.94);
  }


  .search-record__details {
    margin: 0;
    padding: 0;
  }


  .search-record__details div {
    display: grid;
    grid-template-columns: minmax(76px, 0.62fr) minmax(0, 1.38fr);
    align-items: baseline;

    gap: 14px;

    padding: 9px 0;

    border-bottom: 1px solid rgba(65, 75, 99, 0.065);
  }


  .search-record__details div:first-child {
    padding-top: 0;
  }


  .search-record__details div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }


  .search-record__details dt,
  .search-record__changed > p:first-child {
    color: #9298a5;

    font-family: var(--font-ui);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.45;
    text-transform: uppercase;
  }


  .search-record__details dd {
    margin: 0;

    color: #4f5563;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.60;
    text-align: right;
  }


  .search-record__changed {
    margin-top: 16px;
    padding: 16px 17px;

    background: rgba(var(--search-accent-rgb), 0.065);

    border: 1px solid rgba(var(--search-accent-rgb), 0.10);
    border-radius: 15px;
  }


  .search-record__changed > p:first-child {
    margin: 0 0 7px;

    color: var(--search-accent);
  }


  .search-record__changed > p:last-child {
    margin: 0;

    color: #555c69;

    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.66;
  }


  @media (max-width: 900px) {
    .search-dashboard {
      grid-template-columns: 1fr;
    }

    .search-dashboard__brief {
      padding-right: 4px;
    }

    .search-stats {
      margin-top: 27px;
    }

    .search-record {
      grid-template-columns:
        minmax(95px, 0.28fr)
        minmax(0, 1fr);
    }

    .search-record__report {
      grid-column: 2;
    }
  }


  @media (max-width: 650px) {
    .search-shell {
      padding: 22px 15px;

      border-radius: 24px;
    }

    .search-overview {
      grid-template-columns: 1fr;

      gap: 18px;

      padding:
        1px
        3px
        25px;
    }

    .search-overview h3 {
      font-size: 26px;
    }

    .search-summary {
      font-size: 13px;
    }

    .search-dashboard {
      padding: 14px;
      gap: 22px;

      border-radius: 22px;
    }

    .search-dashboard__brief {
      padding: 8px 5px 2px;
    }

    .search-dashboard__brief h3 {
      font-size: 29px;
    }

    .search-dashboard__copy {
      font-size: 13px;
    }

    .search-stats {
      grid-template-columns: 1fr;

      gap: 0;

      padding-top: 12px;
    }

    .search-stats div {
      padding: 10px 0;

      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;

      gap: 16px;

      border-left: 0;
      border-bottom: 1px solid rgba(65, 75, 99, 0.065);
    }

    .search-stats div:first-child {
      padding-top: 0;
    }

    .search-stats div:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .search-stats dd {
      margin: 0;

      font-size: 23px;
    }

    .search-plot {
      min-height: auto;

      padding: 19px;

      display: grid;

      gap: 12px;
    }

    .search-plot__routes,
    .search-plot__region {
      display: none;
    }

    .search-plot__grid {
      background-size: 34px 34px;
    }

    .search-plot__node {
      width: 100%;

      position: relative;
      left: auto;
      top: auto;

      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;

      gap: 13px;

      padding: 11px 12px;

      background: rgba(255, 255, 255, 0.43);

      border: 1px solid rgba(255, 255, 255, 0.68);
      border-radius: 16px;

      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.84);

      transform: none;
    }

    .search-plot__point {
      width: 29px;
    }

    .search-plot__label,
    .search-plot__node--above .search-plot__label,
    .search-plot__node--below .search-plot__label,
    .search-plot__node--left .search-plot__label,
    .search-plot__node--right .search-plot__label {
      width: auto;
      max-width: none;

      position: static;

      text-align: left;

      transform: none;
    }

    .search-plot__label strong {
      font-size: 10px;
    }

    .search-records__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .search-record {
      padding: 26px 3px;

      grid-template-columns: 1fr;

      gap: 19px;
    }

    .search-record__index {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;

      gap: 10px 12px;
    }

    .search-record__number {
      font-size: 40px;
    }

    .search-record__date {
      margin-right: auto;
    }

    .search-record__story h3 {
      font-size: 29px;
    }

    .search-record__description {
      font-size: 13px;
    }

    .search-record__report {
      grid-column: auto;

      padding: 17px;

      border-radius: 19px;
    }

    .search-record__details div {
      grid-template-columns: 1fr;

      gap: 4px;
    }

    .search-record__details dd {
      text-align: left;
    }
  }



  /* ---------------------------------- */
  /* THE MUISCA WORLD                   */
  /* ---------------------------------- */

  .culture-section {
    padding-bottom: 22px;
  }


  .culture-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 6% 4%,
        rgba(218, 166, 94, 0.16),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 8%,
        rgba(118, 169, 239, 0.13),
        transparent 31%
      ),
      radial-gradient(
        circle at 88% 96%,
        rgba(165, 139, 217, 0.12),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.49)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .culture-shell::before {
    content: "";

    width: 440px;
    aspect-ratio: 1;

    position: absolute;
    right: -258px;
    top: 126px;
    z-index: -1;

    border: 1px solid rgba(87, 70, 51, 0.095);
    border-radius: 50%;

    box-shadow:
      0 0 0 54px rgba(255, 255, 255, 0.045),
      0 0 0 108px rgba(87, 70, 51, 0.020);

    pointer-events: none;
  }


  .culture-overview {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(310px, 0.82fr);
    align-items: end;

    gap: clamp(24px, 4vw, 56px);

    padding:
      2px
      4px
      clamp(26px, 3.5vw, 38px);

    border-bottom: 1px solid rgba(66, 76, 99, 0.10);
  }


  .culture-overline,
  .culture-reading__overline {
    margin: 0 0 10px;

    color: #92784f;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  .culture-overview h3 {
    max-width: 650px;

    margin: 0;

    color: #1d2029;

    font-size: clamp(25px, 3.1vw, 38px);
    line-height: 1.25;
  }


  .culture-overview__aside {
    min-width: 0;
  }


  .culture-summary {
    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.80;
  }


  .culture-feature {
    position: relative;
    z-index: 1;

    margin-top: clamp(25px, 3.5vw, 38px);
    padding: clamp(17px, 2.4vw, 27px);

    display: grid;
    grid-template-columns:
      minmax(0, 1.22fr)
      minmax(285px, 0.78fr);
    align-items: stretch;

    gap: clamp(24px, 3.5vw, 42px);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.82),
        rgba(247, 248, 252, 0.55)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(22px, 2.5vw, 30px);

    box-shadow:
      0 18px 42px rgba(50, 62, 88, 0.086),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .culture-hero {
    min-width: 0;

    margin: 0;

    display: flex;
    flex-direction: column;

    gap: 11px;
  }


  .culture-hero__visual {
    width: 100%;
    aspect-ratio: 3 / 2;

    position: relative;
    isolation: isolate;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 22% 16%,
        rgba(255, 255, 255, 0.70),
        transparent 30%
      ),
      radial-gradient(
        circle at 78% 78%,
        rgba(218, 164, 91, 0.22),
        transparent 42%
      ),
      linear-gradient(
        145deg,
        rgba(229, 235, 246, 0.92),
        rgba(244, 239, 233, 0.82)
      );

    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: clamp(18px, 2vw, 24px);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 0 46px rgba(82, 96, 127, 0.055);
  }


  .culture-hero__visual::after {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 3;

    background:
      linear-gradient(
        116deg,
        rgba(255, 255, 255, 0.38),
        transparent 24%,
        transparent 70%,
        rgba(255, 255, 255, 0.12)
      ),
      linear-gradient(
        to top,
        rgba(28, 31, 39, 0.20),
        transparent 34%
      );

    pointer-events: none;
  }


  .culture-hero__visual img {
    width: 100%;
    height: 100%;

    position: relative;
    z-index: 1;

    display: block;

    object-fit: cover;
  }


  .culture-hero__grid {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: block;

    opacity: 0.12;

    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.34) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.34) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 28%,
        black 78%,
        transparent
      );

    -webkit-mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 28%,
        black 78%,
        transparent
      );

    pointer-events: none;
  }


  .culture-hero__label {
    position: absolute;
    top: 17px;
    left: 17px;
    z-index: 4;

    padding: 8px 10px;

    color: rgba(255, 255, 255, 0.90);
    background: rgba(28, 31, 39, 0.24);

    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;

    box-shadow:
      0 8px 18px rgba(30, 34, 46, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.20);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    font-family: var(--font-ui);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }


  .culture-hero__number {
    position: absolute;
    right: 18px;
    bottom: -15px;
    z-index: 4;

    color: rgba(255, 255, 255, 0.28);

    font-family: var(--font-display);
    font-size: clamp(88px, 11vw, 140px);
    line-height: 1;
    letter-spacing: -0.055em;

    text-shadow: 0 10px 28px rgba(28, 31, 39, 0.10);

    pointer-events: none;
  }


  .culture-hero figcaption {
    margin: 0;

    color: #949aa6;

    font-family: var(--font-ui);
    font-size: 9px;
    line-height: 1.55;
    text-align: center;
  }


  .culture-reading {
    min-width: 0;

    padding:
      clamp(12px, 2vw, 22px)
      clamp(3px, 0.8vw, 8px)
      clamp(7px, 1vw, 12px);

    display: flex;
    flex-direction: column;
  }


  .culture-reading h3 {
    margin: 0;

    color: #1d2029;

    font-size: clamp(29px, 3.7vw, 44px);
    line-height: 1.18;
  }


  .culture-reading__copy {
    margin: 17px 0 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.82;
  }


  .culture-reading__points {
    margin: auto 0 0;
    padding: clamp(22px, 3vw, 31px) 0 0;

    list-style: none;

    border-top: 1px solid rgba(65, 75, 99, 0.10);
  }


  .culture-reading__points li {
    position: relative;

    padding: 11px 0 11px 21px;

    color: #555c69;

    border-bottom: 1px solid rgba(65, 75, 99, 0.065);

    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.65;
  }


  .culture-reading__points li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }


  .culture-reading__points li::before {
    content: "";

    width: 7px;
    aspect-ratio: 1;

    position: absolute;
    top: 17px;
    left: 1px;

    background:
      radial-gradient(
        circle at 32% 26%,
        white,
        rgba(217, 172, 108, 0.82) 48%,
        rgba(163, 115, 59, 0.72)
      );

    border: 1px solid rgba(255, 255, 255, 0.94);
    border-radius: 50%;

    box-shadow:
      0 0 0 4px rgba(205, 154, 87, 0.075),
      0 5px 12px rgba(105, 76, 44, 0.13);
  }


  .culture-topics {
    position: relative;
    z-index: 1;

    margin-top: 18px;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 18px;
  }


  .culture-topic {
    --culture-accent: #858b99;
    --culture-accent-rgb: 133, 139, 153;
    --culture-accent-soft: rgba(133, 139, 153, 0.075);

