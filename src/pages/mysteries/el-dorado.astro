  .case-index__scroller::-webkit-scrollbar {
    display: none;
  }


  .case-index__links {
    width: max-content;
    min-width: 100%;

    padding: 0 5px;

    display: flex;
    align-items: center;

    gap: 5px;
  }


  .case-index__links a {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 10px 12px;

    color: #6e7481;
    background: transparent;

    border: 1px solid transparent;
    border-radius: 999px;

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 650;
    letter-spacing: 0.055em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;

    transition:
      color 0.22s ease,
      background 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease,
      transform 0.22s var(--ease-out);
  }


  .case-index__links a > span:first-child {
    color: #9b7a4f;

    font-size: 7px;
    font-weight: 750;
    letter-spacing: 0.08em;
  }


  .case-index__links a:hover {
    color: #292e3a;
    background: rgba(255, 255, 255, 0.52);
    border-color: rgba(255, 255, 255, 0.78);

    transform: translateY(-1px);
  }


  .case-index__links a[aria-current="location"] {
    color: #292e3a;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.93),
        rgba(242, 245, 251, 0.70)
      );

    border-color: rgba(255, 255, 255, 0.96);

    box-shadow:
      0 7px 17px rgba(54, 65, 91, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }


  .case-index__links a[aria-current="location"] > span:first-child {
    color: #8a6334;
  }


  /* ---------------------------------- */
  /* CONTENT SECTIONS                   */
  /* ---------------------------------- */

  .content-section {
    width: min(100%, 1080px);

    margin: 0 auto;
    padding: 74px 0 8px;

    scroll-margin-top: 158px;
  }


  .case-header {
    scroll-margin-top: 118px;
  }


  .section-heading {
    margin-bottom: 28px;

    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;

    gap: 15px;
  }


  .section-number {
    width: 34px;
    aspect-ratio: 1;

    display: grid;
    place-items: center;

    color: #7b8291;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.80),
        rgba(241, 245, 252, 0.53)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: 50%;

    box-shadow:
      0 8px 18px rgba(55, 67, 95, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1);

    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }


  .section-heading h2 {
    margin: 0;

    color: #1d2029;

    font-size: clamp(33px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: 0.012em;
  }


  .section-rule {
    height: 1px;

    display: block;

    background:
      linear-gradient(
        to right,
        rgba(65, 76, 102, 0.16),
        transparent
      );
  }


  /* ---------------------------------- */
  /* MAP CARD                           */
  /* ---------------------------------- */

  .map-card {
    width: 100%;

    margin: 0;
    padding: clamp(18px, 2.6vw, 30px);

    position: relative;
    isolation: isolate;

    display: flex;
    flex-direction: column;

    gap: 23px;

    background:
      radial-gradient(
        circle at 8% 3%,
        rgba(117, 171, 255, 0.16),
        transparent 30%
      ),
      radial-gradient(
        circle at 93% 96%,
        rgba(230, 175, 111, 0.16),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.50)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .map-card::before {
    content: "";

    position: absolute;
    inset: 1px;
    z-index: -1;

    border-radius: inherit;

    background:
      linear-gradient(
        112deg,
        rgba(255, 255, 255, 0.54),
        transparent 28%,
        transparent 74%,
        rgba(255, 255, 255, 0.17)
      );

    opacity: 0.55;
    pointer-events: none;
  }


  .map-viewport {
    width: 100%;

    position: relative;
    isolation: isolate;

    aspect-ratio: 16 / 8.5;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 18% 10%,
        rgba(121, 172, 248, 0.12),
        transparent 36%
      ),
      radial-gradient(
        circle at 88% 92%,
        rgba(221, 170, 110, 0.12),
        transparent 38%
      ),
      linear-gradient(
        145deg,
        rgba(239, 244, 251, 0.74),
        rgba(250, 247, 244, 0.70)
      );

    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: clamp(18px, 2vw, 25px);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      inset 0 0 42px rgba(86, 102, 137, 0.06);
  }


  .map-grid {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: block;

    opacity: 0.18;

    background-image:
      linear-gradient(
        rgba(62, 74, 100, 0.13) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(62, 74, 100, 0.13) 1px,
        transparent 1px
      );

    background-size: 54px 54px;

    mask-image:
      radial-gradient(
        circle at 50% 50%,
        black,
        transparent 78%
      );

    -webkit-mask-image:
      radial-gradient(
        circle at 50% 50%,
        black,
        transparent 78%
      );

    pointer-events: none;
  }


  .map-compass {
    width: clamp(54px, 7vw, 82px);
    aspect-ratio: 1;

    position: absolute;
    right: clamp(15px, 2.6vw, 30px);
    bottom: clamp(15px, 2.6vw, 30px);
    z-index: 3;

    display: block;

    border: 1px solid rgba(71, 78, 96, 0.20);
    border-radius: 50%;

    opacity: 0.38;
    pointer-events: none;
  }


  .map-compass::before,
  .map-compass::after {
    content: "";

    position: absolute;
    top: 50%;
    left: 50%;

    background: rgba(71, 78, 96, 0.24);

    transform: translate(-50%, -50%);
  }


  .map-compass::before {
    width: 1px;
    height: 72%;
  }


  .map-compass::after {
    width: 72%;
    height: 1px;
  }


  /*
    THIS IS THE ZOOMED WORLD MAP.

    width controls the zoom.

    left moves the world map
    horizontally.

    top moves the world map
    vertically.
  */

  .map-world {
    width: 250%;

    position: absolute;
    z-index: 1;

    left: -20%;
    top: -70%;
  }


  .map-image {
    width: 125%;

    display: block;

    opacity: 0.78;

    filter:
      grayscale(100%)
      contrast(1.04)
      sepia(8%);
  }


  /*
    These percentages are positions on
    the FULL WORLD MAP rather than
    positions inside the visible card.
  */

  .map-marker {
    width: 5%;
    aspect-ratio: 1;

    position: absolute;

    top: 47.5%;
    left: 27.5%;

    transform: translate(-50%, -50%);
    pointer-events: none;
  }


  .marker-area {
    position: absolute;
    inset: 0;

    display: block;

    background: rgba(222, 171, 99, 0.20);

    border: 1px solid rgba(199, 142, 70, 0.23);
    border-radius: 50%;

    box-shadow:
      0 0 0 8px rgba(228, 183, 119, 0.06),
      0 10px 30px rgba(150, 101, 49, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.48);

    backdrop-filter: blur(0.7px);
    -webkit-backdrop-filter: blur(0.7px);

    animation:
      marker-pulse
      3.4s
      ease-in-out
      infinite;
  }


  .marker-core {
    width: 14%;
    aspect-ratio: 1;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    background: rgba(130, 88, 44, 0.70);
    border-radius: 50%;

    box-shadow:
      0 0 0 5px rgba(255, 255, 255, 0.26),
      0 4px 12px rgba(105, 69, 36, 0.22);

    transform: translate(-50%, -50%);
  }


  .map-caption {
    max-width: 640px;

    margin: 0 auto;

    color: #858b99;

    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1.72;
    letter-spacing: 0.025em;
    text-align: center;
  }


  /* ---------------------------------- */
  /* TIMELINE                           */
  /* ---------------------------------- */

  .timeline-section {
    padding-bottom: 22px;
  }


  .timeline-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 7% 4%,
        rgba(118, 171, 249, 0.15),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 98%,
        rgba(228, 174, 109, 0.15),
        transparent 32%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.78),
        rgba(246, 249, 255, 0.48)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .timeline-shell::before {
    content: "";

    width: 360px;
    aspect-ratio: 1;

    position: absolute;
    right: -190px;
    bottom: -210px;
    z-index: -1;

    border: 1px solid rgba(92, 71, 49, 0.12);
    border-radius: 50%;

    box-shadow:
      0 0 0 42px rgba(255, 255, 255, 0.06),
      0 0 0 84px rgba(92, 71, 49, 0.025);

    pointer-events: none;
  }


  .timeline {
    max-width: 900px;

    position: relative;

    padding-left: 44px;
  }


  .timeline::before {
    content: "";

    position: absolute;

    top: 13px;
    bottom: 13px;
    left: 8px;

    width: 2px;

    background:
      linear-gradient(
        to bottom,
        rgba(120, 167, 238, 0.64),
        rgba(169, 140, 217, 0.45),
        rgba(218, 168, 101, 0.50)
      );

    border-radius: 999px;

    box-shadow: 0 0 16px rgba(123, 148, 205, 0.16);
  }


  .timeline-item {
    position: relative;

    margin-bottom: 17px;
  }


  .timeline-item:last-child {
    margin-bottom: 0;
  }


  .timeline-marker {
    width: 18px;
    aspect-ratio: 1;

    position: absolute;

    top: 31px;
    left: -44px;

    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(213, 225, 249, 0.92) 45%,
        rgba(115, 150, 219, 0.72)
      );

    border: 1px solid rgba(255, 255, 255, 0.94);
    border-radius: 50%;

    box-shadow:
      0 0 0 5px rgba(125, 161, 230, 0.11),
      0 8px 18px rgba(69, 87, 128, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }


  .timeline-item:nth-child(3n + 2) .timeline-marker {
    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(226, 216, 244, 0.92) 45%,
        rgba(159, 131, 207, 0.72)
      );

    box-shadow:
      0 0 0 5px rgba(162, 137, 211, 0.10),
      0 8px 18px rgba(88, 73, 119, 0.17),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }


  .timeline-item:nth-child(3n) .timeline-marker {
    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(245, 224, 192, 0.92) 45%,
        rgba(202, 148, 78, 0.72)
      );

    box-shadow:
      0 0 0 5px rgba(211, 161, 93, 0.10),
      0 8px 18px rgba(117, 82, 43, 0.17),
      inset 0 1px 0 rgba(255, 255, 255, 1);
  }


  .timeline-content {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding: 26px 30px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.52)
      );

    border: 1px solid rgba(255, 255, 255, 0.90);
    border-radius: 22px;

    box-shadow:
      0 13px 32px rgba(50, 62, 88, 0.075),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

    transition:
      transform 0.30s var(--ease-out),
      box-shadow 0.30s ease;
  }


  .timeline-content::before {
    content: "";

    width: 150px;
    height: 180px;

    position: absolute;
    top: -130px;
    right: -48px;
    z-index: -1;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(121, 170, 245, 0.18),
        transparent 70%
      );

    transition: transform 0.42s var(--ease-out);
  }


  .timeline-item:nth-child(3n + 2) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(170, 141, 218, 0.17),
        transparent 70%
      );
  }


  .timeline-item:nth-child(3n) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(222, 170, 99, 0.18),
        transparent 70%
      );
  }


  .timeline-content:hover {
    transform: translateY(-3px);

    box-shadow:
      0 20px 42px rgba(50, 62, 88, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .timeline-content:hover::before {
    transform: translate(-8px, 9px) scale(1.08);
  }


  .timeline-date {
    margin: 0 0 11px;

    color: #7d94c5;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }


  .timeline-item:nth-child(3n + 2) .timeline-date {
    color: #967fbd;
  }


  .timeline-item:nth-child(3n) .timeline-date {
    color: #ae7f47;
  }


  .timeline-content h3 {
    margin: 0 0 11px;

    color: #1e212b;

    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.3;
  }


  .timeline-content p:last-child {
    max-width: 700px;

    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.82;
  }


  /* ---------------------------------- */
  /* EVIDENCE                           */
  /* ---------------------------------- */

  .evidence-section {
    padding-bottom: 22px;
  }


  .evidence-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 6% 4%,
        rgba(118, 171, 249, 0.14),
        transparent 31%
      ),
      radial-gradient(
        circle at 95% 10%,
        rgba(170, 141, 218, 0.11),
        transparent 30%
      ),
      radial-gradient(
        circle at 92% 96%,
        rgba(228, 174, 109, 0.15),
        transparent 33%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.49)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .evidence-shell::before {
    content: "";

    width: 390px;
    aspect-ratio: 1;

    position: absolute;
    right: -235px;
    top: 112px;
    z-index: -1;

    border: 1px solid rgba(92, 71, 49, 0.10);
    border-radius: 50%;

    box-shadow:
      0 0 0 48px rgba(255, 255, 255, 0.05),
      0 0 0 96px rgba(92, 71, 49, 0.022);

    pointer-events: none;
  }


  .evidence-overview {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(310px, 0.82fr);
    align-items: end;

    gap: clamp(24px, 4vw, 56px);

    padding:
      2px
      4px
      clamp(26px, 3.5vw, 38px);

    border-bottom: 1px solid rgba(66, 76, 99, 0.10);
  }


  .evidence-overline {
    margin: 0 0 10px;

    color: #92784f;

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  .evidence-overview h3 {
    max-width: 570px;

    margin: 0;

    color: #1d2029;

    font-size: clamp(25px, 3.1vw, 38px);
    line-height: 1.25;
  }


  .evidence-overview__aside {
    min-width: 0;
  }


  .evidence-summary {
    margin: 0;

    color: #69707f;

    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.80;
  }



  .evidence-featured {
    margin-top: clamp(25px, 3.5vw, 38px);
    padding: clamp(17px, 2.4vw, 27px);

    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1.08fr)
      minmax(310px, 0.92fr);
    align-items: stretch;

    gap: clamp(24px, 3.4vw, 42px);

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.82),
        rgba(247, 248, 252, 0.55)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(22px, 2.5vw, 30px);

    box-shadow:
      0 18px 42px rgba(50, 62, 88, 0.09),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

    transition:
      transform 0.30s var(--ease-out),
      box-shadow 0.30s ease;
  }


  .evidence-featured:hover {
    transform: translateY(-3px);

    box-shadow:
      0 24px 52px rgba(50, 62, 88, 0.125),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .evidence-featured__content {
    min-width: 0;

    display: flex;
    flex-direction: column;

    padding:
      clamp(8px, 1.7vw, 18px)
      clamp(3px, 1vw, 9px)
      clamp(6px, 1.1vw, 11px);
  }


  .evidence-grid {
    position: relative;
    z-index: 1;

    margin-top: 18px;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 18px;
  }


  .evidence-card {
    min-width: 0;

    display: flex;
    flex-direction: column;

    padding: 17px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.52)
      );

    border: 1px solid rgba(255, 255, 255, 0.90);
    border-radius: 24px;

    box-shadow:
      0 14px 34px rgba(50, 62, 88, 0.078),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

    transition:
      transform 0.30s var(--ease-out),
      box-shadow 0.30s ease;
  }


  .evidence-card:hover {
    transform: translateY(-3px);

    box-shadow:
      0 21px 44px rgba(50, 62, 88, 0.115),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);
  }


  .evidence-card:only-child {
    grid-column: 1 / -1;
  }


  /* Keep an odd final card at the same width as the others and centre it. */
  .evidence-card:last-child:nth-child(odd):not(:only-child) {
    width: calc((100% - 18px) / 2);

    grid-column: 1 / -1;
    justify-self: center;
  }


  .evidence-card__body {
    min-width: 0;
    flex: 1;

    display: flex;
    flex-direction: column;

    padding:
      22px
      6px
      5px;
  }


  .evidence-visual {
    width: 100%;
    aspect-ratio: 4 / 3;

    position: relative;
    isolation: isolate;

    overflow: hidden;

    background:
      radial-gradient(
        circle at 24% 16%,
        rgba(255, 255, 255, 0.72),
        transparent 31%
      ),
      linear-gradient(
        145deg,
        rgba(235, 240, 249, 0.86),
        rgba(244, 241, 238, 0.78)
      );

    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: clamp(18px, 2vw, 24px);

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 0 42px rgba(86, 102, 137, 0.055);
  }


  .evidence-visual::before {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 3;

    background:
      linear-gradient(
        116deg,
        rgba(255, 255, 255, 0.42),
        transparent 25%,
        transparent 72%,
        rgba(255, 255, 255, 0.15)
      );

    pointer-events: none;
  }


  .evidence-visual--blue {
    background:
      radial-gradient(
        circle at 20% 14%,
        rgba(255, 255, 255, 0.76),
        transparent 31%
      ),
      radial-gradient(
        circle at 80% 76%,
