  .account-record {
    --account-accent: #7a818f;
    --account-accent-rgb: 122, 129, 143;
    --account-accent-soft: rgba(122, 129, 143, 0.09);
    --account-accent-faint: rgba(122, 129, 143, 0.055);

    min-width: 0;

    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding: clamp(25px, 3.5vw, 39px);

    background:
      radial-gradient(
        circle at 97% 2%,
        var(--account-accent-soft),
        transparent 33%
      ),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 27px,
        rgba(75, 83, 104, 0.018) 28px
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.82),
        rgba(247, 248, 252, 0.55)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(22px, 2.5vw, 30px);

    box-shadow:
      0 18px 42px rgba(50, 62, 88, 0.085),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.035);

