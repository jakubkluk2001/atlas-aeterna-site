  .timeline-item:nth-child(3n + 2) .timeline-date {
    color: #967fbd;
  }


  .timeline-item:nth-child(3n) .timeline-date {
    color: #ae7f47;
  }


  .timeline-content h3 {
    margin: 0 0 11px;

    color: #1e212b;

    font-size: clamp(21px, 2.4vw, 28px);
    line-height: 1.3;
