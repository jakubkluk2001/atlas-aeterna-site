    ],
  },
];


type AccountTone = "gold" | "blue" | "violet" | "neutral";
type AccountEmphasis = "standard" | "defining";

interface HistoricalAccount {
  id: string;
  number: string;
  date: string;
  author: string;
  work: string;
  sourceType: string;
  focus: string;
  claim: string;
  summary: string;
  significance: string;
  tone: AccountTone;
  emphasis: AccountEmphasis;
  details: Array<{
    label: string;
    value: string;
  }>;
}

/*
  The Accounts is a variable-length source-record module. It distinguishes what
  an author personally observed from what they reported, without assigning a
  simple true/false verdict. The five entries below were selected because each
  preserves a substantially different and influential form of the El Dorado case.
*/
const historicalAccounts: HistoricalAccount[] = [
  {
    id: "oviedo",
    number: "01",
    date: "1541",
    author: "Gonzalo Fernández de Oviedo",
    work: "Historia general y natural de las Indias",
    sourceType: "Early recorded report",
    focus: "The gilded ruler",
    claim:
      "A powerful ruler was said to coat his body with resin and fine gold powder, washing it away and repeating the display.",
    summary:
      "Oviedo records a story circulating among Spaniards in Quito. In this account El Dorado is a person rather than a city, and the report does not yet place him at Guatavita or describe a raft ceremony.",
    significance:
      "It is one of the earliest detailed surviving descriptions of El Dorado and preserves the gilded-man form of the tradition with unusual clarity.",
    tone: "gold",
    emphasis: "standard",
    details: [
      {
        label: "Basis of account",
        value:
          "Information Oviedo says came through Spaniards who had heard Indigenous reports",
      },
      {
        label: "Source position",
        value:
          "Near-contemporary to the rumour, but not an eyewitness to the ruler",
      },
      {
        label: "Relation to the record",
        value:
          "Preserves the gilded-person form before the lake and city traditions appear in fuller detail",
      },
    ],
  },
  {
    id: "castellanos",
    number: "02",
    date: "c. 1589",
    author: "Juan de Castellanos",
    work: "Elegías de varones ilustres de Indias",
    sourceType: "Retrospective chronicle",
    focus: "The ruler, raft & lake",
    claim:
      "Belalcázar was said to have heard of a ruler from the Bogotá region who went onto a lake by raft, covered in gold dust, while gold and emerald offerings were made.",
    summary:
      "Castellanos brings together the gilded ruler, a body of water, a raft, offerings and reports of regional wealth. His verse chronicle was written decades after the episode it describes.",
    significance:
      "It preserves a version in which the gilded ruler, raft, lake, offerings and regional wealth appear together in the surviving record.",
    tone: "blue",
    emphasis: "standard",
    details: [
      {
        label: "Basis of account",
        value:
          "A story attributed to information heard by Sebastián de Belalcázar",
      },
      {
        label: "Source position",
        value:
          "Retrospective; Castellanos did not witness the reported encounter",
      },
      {
        label: "Relation to the record",
        value:
          "Later Guatavita accounts preserve closely related material and add further detail",
      },
    ],
  },
  {
    id: "raleigh",
    number: "03",
    date: "1596",
    author: "Walter Raleigh",
    work: "The Discoverie of Guiana",
    sourceType: "Voyage account",
    focus: "The great golden city",
    claim:
      "Manoa was presented as the great and golden city of a rich Guianan empire — the place the Spaniards called El Dorado.",
    summary:
      "Raleigh had travelled through Guiana and the Orinoco, but he did not reach Manoa. His case for the city combined his own journey with Spanish reports, captured correspondence and testimony gathered around the expedition.",
    significance:
      "It is the clearest and most influential surviving formulation of El Dorado as a magnificent city and empire rather than only a gilded ruler or lake ceremony.",
    tone: "violet",
    emphasis: "defining",
    details: [
      {
        label: "Basis of account",
        value:
          "Firsthand travel in Guiana combined with second-hand evidence for Manoa",
      },
      {
        label: "Source position",
        value:
          "Eyewitness to the region and voyage, but not to the city itself",
      },
      {
        label: "Relation to the record",
        value:
          "Connects the name El Dorado directly with Manoa and an eastern golden empire",
      },
    ],
  },
  {
    id: "simon",
    number: "04",
    date: "1627",
    author: "Fray Pedro Simón",
    work: "Noticias historiales",
    sourceType: "Colonial chronicle",
    focus: "Guatavita and offering practice",
    claim:
      "A naked cacique was said to be covered in gold dust and to offer gold and emeralds in a lake; Simón later places the tradition within Guatavita’s ritual landscape.",
    summary:
      "Simón also describes practices that he says Spaniards witnessed around Guatavita: people travelled to the lake and ritual specialists made offerings from rafts. His account therefore preserves material of different kinds and distances from the events.",
    significance:
      "It links the golden-man tradition to Guatavita and places it alongside recorded ceremonial activity at the lake.",
    tone: "blue",
    emphasis: "standard",
    details: [
      {
        label: "Basis of account",
        value:
          "Earlier testimony, local tradition and observations connected with the lake",
      },
      {
        label: "Source position",
        value:
          "The origin story is retrospective; some offering practices were contemporary",
      },
      {
        label: "Relation to the record",
        value:
          "Shares core material with Castellanos while adding explicit Guatavita context",
      },
    ],
  },
  {
    id: "rodriguez-freyle",
    number: "05",
    date: "1636–1638",
    author: "Juan Rodríguez Freyle",
    work: "El Carnero",
    sourceType: "Colonial narrative",
    focus: "The full investiture ceremony",
    claim:
      "The heir to Guatavita’s chiefdom fasts, is covered in powdered gold, boards a decorated raft with four chiefs and casts gold and emeralds into the lake before being received as ruler.",
    summary:
      "This is the most complete version of the famous ceremony. It firmly identifies the event as the investiture of Guatavita’s successor, a political meaning that earlier chroniclers do not clearly state.",
    significance:
      "Its vivid account supplied the enduring image of the golden ruler, the raft, the sacred lake and the public ceremony that now defines El Dorado in historical memory.",
    tone: "gold",
    emphasis: "defining",
    details: [
      {
        label: "Basis of account",
        value:
          "A later colonial narrative drawing on traditions and memory associated with Guatavita",
