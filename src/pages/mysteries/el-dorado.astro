    role: "Farmer & discoverer",
    tone: "neutral",
    image: null,
    alt: "",
    initials: "CD",
    summary:
      "Discovered the votive deposit near Pasca that contained the Muisca Raft, bringing the case its most famous surviving object.",
    profile:
      "Dimaté found a ceramic vessel in a cave while hunting near Pasca in 1969. With the help of the local priest, the importance of its contents was recognised and the deposit reached the Banco de la República. The Muisca Raft became the strongest material image associated with the ceremonial origins of El Dorado.",
    details: [
      {
        label: "Place in the case",
        value: "Discoverer of the deposit containing the Muisca Raft",
      },
      {
        label: "Associated location",
        value: "Pasca, Cundinamarca",
      },
    ],
    references: [
      { label: "The Muisca Raft", href: "#evidence-title-muisca-raft" },
      { label: "Timeline", href: "#timeline" },
    ],
  },
];


---

<BaseLayout
  title="El Dorado | Atlas Aeterna"
  description="Explore the legend of El Dorado, its location and the history of the search for the legendary source of extraordinary wealth."
>
  <article class="case-page">
    <!-- -------------------------------- -->
    <!-- SHARED CASE CORE                 -->
    <!-- -------------------------------- -->

    <CaseHeader
      title="El Dorado"
      intro="El Dorado is one of history’s most enduring legends, a tale of gold, discovery and a hidden land of extraordinary wealth somewhere in the vast landscapes of South America."
    />

    <CaseIndex sections={caseSections} />

    <LocationSection
      alt="World map showing the approximate region associated with El Dorado"
      caption="Approximate region associated with the origins of the El Dorado legend in present-day Colombia."
      map={{
        worldWidth: "250%",
        worldLeft: "-20%",
        worldTop: "-70%",
        markerTop: "47.5%",
        markerLeft: "27.5%",
      }}
    />

    <TimelineSection events={timelineEvents} />


    <!-- -------------------------------- -->
    <!-- EVIDENCE                         -->
    <!-- -------------------------------- -->

    <EvidenceSection
      featured={featuredEvidence}
      items={supportingEvidence}
      overline="The surviving record"
      overviewTitle="One defining artefact behind a larger legend"
      summary="The Muisca Raft is the strongest surviving material link between El Dorado and a real ceremonial tradition. The surrounding evidence supports that origin, while the later golden-city story becomes increasingly uncertain."
    />

    <!-- -------------------------------- -->
    <!-- WORKING THEORIES                 -->
    <!-- -------------------------------- -->

    <WorkingTheoriesSection
      theories={workingTheories}
      overline="Interpreting the record"
      overviewTitle="What was El Dorado?"
      summary="These interpretations are not equally supported. The first is the leading historical reconstruction, the second is an open possibility within the later reports, and the third is the legend in its fullest form."
    />

    <!-- -------------------------------- -->
    <!-- THE SEARCH                       -->
    <!-- -------------------------------- -->

    <SearchSection
      records={searchRecords}
      overline="Attempts to resolve the case"
      overviewTitle="What happened when people went looking?"
      summary="El Dorado was pursued through lake drainage, overland marches and river expeditions. These records focus on the attempts that materially changed where the legend was placed, what searchers expected to find or how the evidence was understood."
      dashboard={{
        overline: "The search field",
        title: "A target that moved when each attempt failed",
        copy: "Early searchers pushed east from Quito and targeted Guatavita. Later expeditions crossed Amazonia and the llanos, gathered around the Orinoco and Manoa, then returned to the lake with industrial machinery.",
        stats: [
          { label: "Selected attempts", value: String(searchRecords.length).padStart(2, "0") },
          { label: "Centuries represented", value: "03" },
          { label: "Primary methods", value: "03" },
        ],
      }}
    >
      <SearchRoutePlot
        slot="visual"
        nodes={searchRoute}
        regions={searchRouteRegions}
        contourPaths={searchContourPaths}
        routePath={searchRoutePath}
        caption="A schematic record of the search’s changing focus, arranged chronologically rather than as a precise route map."
      />
    </SearchSection>

    <!-- -------------------------------- -->
    <!-- THE MUISCA WORLD                 -->
    <!-- -------------------------------- -->

    <CulturalContextSection
      id="muisca-world"
      number="06"
      title="The Muisca World"
      overline="The culture beneath the legend"
      overviewTitle="Gold meant something very different here"
      summary="The Muisca were not a hidden golden empire but a network of highland chiefdoms. Their metalwork, sacred places, exchange systems and political ceremonies formed the real cultural world from which El Dorado was later reconstructed."
      topics={muiscaWorldTopics}
      topicsLabel="Key aspects of the Muisca world"
      hero={{
        image: "/images/mysteries/el-dorado/muisca-world.webp",
        alt: "Composite view of Muisca votive figures and ceremonial metalwork",
        label: "Material culture",
        fallbackMark: "M",
        fallbackCopy: "Material culture image unavailable",
        caption: "Votive figures and ceremonial objects reveal a broader ritual world than the single image of a gilded ruler.",
      }}
      reading={{
        overline: "Read the objects differently",
        title: "Not treasure waiting to be taken",
        copy: "Muisca goldwork could be created expressly for offering. Once placed in a sacred setting, an object participated in ritual relationships rather than simply functioning as portable wealth.",
        points: [
          "Metalwork carried social, political and spiritual meaning.",
          "Offerings were deliberately placed beyond ordinary circulation.",
          "An object’s purpose mattered as much as its raw material.",
        ],
      }}
    />

    <!-- -------------------------------- -->
    <!-- THE ACCOUNTS                     -->
    <!-- -------------------------------- -->

    <AccountsSection
      id="the-accounts"
      number="07"
      title="The Accounts"
      accounts={historicalAccounts}
      overline="The surviving testimony"
      overviewTitle="What did the record actually say?"
      summary="These five accounts were written at different times and from different kinds of knowledge. They are presented as testimony: what each author recorded, where the information came from and how that version shaped the case."
      registerLabel="Source register"
    />

    <!-- -------------------------------- -->
    <!-- KEY FIGURES                      -->
    <!-- -------------------------------- -->

    <KeyFiguresSection
      id="key-figures"
      number="08"
      title="Key Figures"
      figures={keyFigures}
      overline="People in the case"
      overviewTitle="The searchers, writers and later investigators"
      summary={`These ${keyFigures.length} people were selected for the distinct part each played in encountering, pursuing, recording or materially reshaping the El Dorado case. The gallery is a reference index rather than another required chapter.`}
      interactionNote="Swipe the gallery or use the arrows. Open a profile for the fuller case connection and direct links back into the file."
    />

  </article>


</BaseLayout>


<style>
  .case-page {
    --case-blue: #84a9ee;
    --case-gold: #d9ad72;
    --case-violet: #a58bd9;

    padding: 18px 0 38px;
  }

  @media (max-width: 650px) {
    .case-page {
      padding-top: 0;
    }
  }
</style>
