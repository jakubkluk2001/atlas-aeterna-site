  .theories-section {
    padding-bottom: 22px;
  }


  .theories-shell {
    position: relative;
    isolation: isolate;

    overflow: hidden;

    padding:
      clamp(25px, 4vw, 46px)
      clamp(20px, 4vw, 44px);

    background:
      radial-gradient(
        circle at 7% 4%,
        rgba(217, 173, 114, 0.15),
        transparent 31%
      ),
      radial-gradient(
        circle at 94% 8%,
        rgba(121, 169, 238, 0.13),
        transparent 30%
      ),
      radial-gradient(
        circle at 91% 96%,
        rgba(165, 139, 217, 0.13),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.79),
        rgba(246, 249, 255, 0.49)
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: clamp(24px, 2.7vw, 34px);

    box-shadow:
      0 24px 60px rgba(50, 62, 88, 0.10),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(55, 65, 88, 0.04);

    backdrop-filter:
      blur(24px)
      saturate(150%);

    -webkit-backdrop-filter:
      blur(24px)
      saturate(150%);
  }


  .theories-shell::before {
    content: "";

    width: 420px;
    aspect-ratio: 1;

    position: absolute;
    right: -245px;
    top: 116px;
    z-index: -1;

    border: 1px solid rgba(85, 72, 59, 0.10);
    border-radius: 50%;

    box-shadow:
      0 0 0 52px rgba(255, 255, 255, 0.05),
      0 0 0 104px rgba(85, 72, 59, 0.022);

    pointer-events: none;
  }


  .theories-overview {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(310px, 0.82fr);
    align-items: end;

    gap: clamp(24px, 4vw, 56px);

    padding:
      2px
      4px
      clamp(26px, 3.5vw, 38px);

    border-bottom: 1px solid rgba(66, 76, 99, 0.10);
  }


