  /* ---------------------------------- */
  /* EDGE DETAILS                       */
  /* ---------------------------------- */

  .edge-mark {
    width: 40px;
    height: 40px;

    position: absolute;
    z-index: 4;

    opacity: 0.28;
    pointer-events: none;
  }


  .edge-mark::before,
  .edge-mark::after {
    content: "";

    position: absolute;

    background: rgba(78, 67, 55, 0.27);
    border-radius: 999px;
  }


  .edge-mark::before {
    width: 40px;
    height: 1px;
  }


  .edge-mark::after {
    width: 1px;
    height: 40px;
  }


  .edge-mark--top-left {
    top: 24px;
    left: 24px;
  }


  .edge-mark--top-right {
    top: 24px;
    right: 24px;

    transform: rotate(90deg);
  }


  .edge-mark--bottom-left {
    bottom: 24px;
    left: 24px;

    transform: rotate(-90deg);
  }


  .edge-mark--bottom-right {
    right: 24px;
    bottom: 24px;

    transform: rotate(180deg);
  }


  /* ---------------------------------- */
  /* MOTION                             */
  /* ---------------------------------- */

  @keyframes content-enter {
    from {
      opacity: 0;
      transform: translateY(17px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  @keyframes object-float {
    0%,
    100% {
      transform:
        translateY(calc(-50% - 5px))
        rotate(-0.5deg);
    }

    50% {
      transform:
        translateY(calc(-50% + 7px))
        rotate(0.7deg);
    }
  }


  @keyframes marker-pulse {
    0%,
    100% {
      opacity: 0.80;
      transform: scale(0.94);
    }

    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }


  /* ---------------------------------- */
  /* TABLET                             */
  /* ---------------------------------- */

  @media (max-width: 980px) {
    .case-header {
      min-height: 590px;
    }

    .case-header__content {
      width: min(74%, 800px);
