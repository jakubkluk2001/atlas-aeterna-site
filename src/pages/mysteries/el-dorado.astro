    top: -130px;
    right: -48px;
    z-index: -1;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(121, 170, 245, 0.18),
        transparent 70%
      );

    transition: transform 0.42s var(--ease-out);
  }


  .timeline-item:nth-child(3n + 2) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(170, 141, 218, 0.17),
        transparent 70%
      );
  }


  .timeline-item:nth-child(3n) .timeline-content::before {
    background:
      radial-gradient(
        circle,
        rgba(222, 170, 99, 0.18),
