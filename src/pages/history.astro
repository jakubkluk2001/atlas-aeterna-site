---
import polandFlag from "../assets/flags/poland.svg?url";
import CountrySpotlights from "../components/sections/CountrySpotlights.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionOpening from "../components/sections/SectionOpening.astro";
---

<BaseLayout
  sectionPlaceholder
  title="History | Atlas Aeterna"
  description="The history collection of Atlas Aeterna is still in development."
>
  <SectionOpening
    title="History"
    intro="Explore the people, societies, and turning points that shaped the world we know today."
    titleId="placeholder-title"
  >
    <CountrySpotlights stories={[
      {
        country: "Poland",
        title: "Unconquered",
        href: "/history/unconquered",
        flag: polandFlag,
        tone: "rose",
        inDevelopment: true,
      },
    ]} />
  </SectionOpening>
</BaseLayout>
