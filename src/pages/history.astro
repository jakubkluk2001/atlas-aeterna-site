---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="History | Atlas Aeterna"
  description="The history collection of Atlas Aeterna is still in development."
>
  <section class="placeholder-page history-page">
    <svg
      class="contour-lines contour-lines--left"
      viewBox="0 0 620 620"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-36 448C42 357 98 386 158 314C216 245 221 157 318 112C414 67 499 107 656 -14" />
      <path d="M-18 485C63 396 128 418 190 346C254 270 263 188 354 143C450 96 529 131 651 39" />
      <path d="M7 523C85 446 159 453 224 384C294 311 304 225 390 182C476 139 548 155 644 95" />
      <path d="M48 562C124 504 189 499 260 432C334 363 349 284 426 241C500 200 562 204 637 164" />
    </svg>

    <svg
      class="contour-lines contour-lines--right"
      viewBox="0 0 620 620"
      fill="none"
      aria-hidden="true"
    >
      <path d="M-36 448C42 357 98 386 158 314C216 245 221 157 318 112C414 67 499 107 656 -14" />
      <path d="M-18 485C63 396 128 418 190 346C254 270 263 188 354 143C450 96 529 131 651 39" />
      <path d="M7 523C85 446 159 453 224 384C294 311 304 225 390 182C476 139 548 155 644 95" />
      <path d="M48 562C124 504 189 499 260 432C334 363 349 284 426 241C500 200 562 204 637 164" />
    </svg>

    <div class="history-object" aria-hidden="true">
      <span class="history-object__halo"></span>
      <span class="history-object__disc"></span>
      <span class="history-object__ring history-object__ring--outer"></span>
      <span class="history-object__ring history-object__ring--inner"></span>
      <span class="history-object__hand history-object__hand--long"></span>
      <span class="history-object__hand history-object__hand--short"></span>
      <span class="history-object__centre"></span>
      <span class="history-object__node history-object__node--one"></span>
      <span class="history-object__node history-object__node--two"></span>
    </div>

    <div class="placeholder-content">
      <p class="eyebrow">
        Atlas Aeterna
      </p>

      <h1>History</h1>

      <p class="message">
        This part of Atlas Aeterna is still in development.
      </p>
    </div>

    <span class="edge-mark edge-mark--top-left" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--top-right" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--bottom-left" aria-hidden="true"></span>
    <span class="edge-mark edge-mark--bottom-right" aria-hidden="true"></span>
  </section>
</BaseLayout>


<style>
  .placeholder-page {
    min-height: min(790px, calc(100svh - 118px));

    position: relative;
    isolation: isolate;

    display: grid;
    place-items: center;

    overflow: hidden;

    padding:
      clamp(88px, 10vw, 140px)
      clamp(24px, 6vw, 80px);

    background:
      radial-gradient(
        circle at 9% 7%,
        rgba(239, 183, 143, 0.30),
        transparent 33%
      ),
      radial-gradient(
        circle at 90% 9%,
        rgba(170, 145, 242, 0.25),
        transparent 35%
      ),
      radial-gradient(
        circle at 50% 110%,
        rgba(117, 171, 255, 0.22),
        transparent 40%
      ),
      linear-gradient(
        142deg,
        rgba(255, 255, 255, 0.76),
        rgba(250, 247, 246, 0.48) 48%,
        rgba(246, 249, 255, 0.48)
      );

    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: clamp(30px, 3.2vw, 48px);

    box-shadow:
      0 44px 110px rgba(50, 62, 88, 0.13),
      0 12px 34px rgba(50, 62, 88, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 1),
      inset 0 -1px 0 rgba(58, 69, 94, 0.045);

    backdrop-filter:
      blur(30px)
      saturate(155%);

    -webkit-backdrop-filter:
      blur(30px)
      saturate(155%);

    text-align: center;
  }


  .placeholder-page::after {
    content: "";

    position: absolute;
    inset: 1px;
    z-index: 5;

    border-radius: inherit;

    background:
      linear-gradient(
        112deg,
        rgba(255, 255, 255, 0.58),
        transparent 25%,
        transparent 72%,
        rgba(255, 255, 255, 0.20)
      );

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 24%,
        transparent 76%,
        black
      );

    -webkit-mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 24%,
        transparent 76%,
        black
      );

    opacity: 0.54;
    pointer-events: none;
  }


  .placeholder-content {
    width: 100%;
    max-width: 850px;

    position: relative;
    z-index: 3;

    display: flex;
    flex-direction: column;
    align-items: center;

    animation:
      content-enter
      0.85s
      var(--ease-out)
      both;
  }


  .eyebrow {
    margin: 0 0 24px;
    padding: 9px 14px;

    color: #6a6f7d;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.74),
        rgba(247, 249, 254, 0.43)
      );

    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 999px;

    box-shadow:
      0 10px 28px rgba(57, 69, 97, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.98);

    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  h1 {
    margin: 0;

    background:
      linear-gradient(
        180deg,
        #171922 0%,
        #2a2e39 66%,
        #454a57 100%
      );

    -webkit-background-clip: text;
    background-clip: text;

    font-size: clamp(74px, 11vw, 152px);
    line-height: 0.92;
    letter-spacing: 0.045em;

    -webkit-text-fill-color: transparent;

    filter: drop-shadow(0 2px 0 rgba(255, 255, 255, 0.36));
  }


  .message {
    max-width: 620px;

    margin: 30px 0 0;

    color: #69707e;

    font-family: var(--font-ui);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.8;
    text-wrap: balance;
  }


  /* ---------------------------------- */
  /* HISTORY OBJECT                     */
  /* ---------------------------------- */

  .history-object {
    width: clamp(420px, 54vw, 760px);
    aspect-ratio: 1;

    position: absolute;
    top: 47%;
    left: 50%;
    z-index: -1;

    opacity: 0.71;

    filter:
      drop-shadow(0 36px 42px rgba(71, 79, 105, 0.13));

    transform: translate(-50%, -50%);
    pointer-events: none;

    animation:
      object-float
      11s
      ease-in-out
      infinite;
  }


  .history-object__halo {
    position: absolute;
    inset: 7%;

    display: block;

    border-radius: 50%;

    background:
      repeating-conic-gradient(
        from -1deg,
        rgba(55, 64, 88, 0.25) 0deg 0.7deg,
        transparent 0.7deg 15deg
      );

    mask-image:
      radial-gradient(
        circle,
        transparent 0 45%,
        black 45.5% 47%,
        transparent 47.5% 100%
      );

    -webkit-mask-image:
      radial-gradient(
        circle,
        transparent 0 45%,
        black 45.5% 47%,
        transparent 47.5% 100%
      );
  }


  .history-object__disc {
    width: 55%;
    aspect-ratio: 1;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;
    overflow: hidden;

    background:
      radial-gradient(
        circle at 30% 24%,
        rgba(255, 255, 255, 0.96),
        rgba(255, 255, 255, 0.44) 19%,
        rgba(232, 196, 169, 0.21) 49%,
        rgba(169, 153, 201, 0.14) 70%,
        rgba(126, 161, 218, 0.12) 88%
      );

    border: 1px solid rgba(255, 255, 255, 0.91);
    border-radius: 50%;

    box-shadow:
      inset 18px 22px 34px rgba(255, 255, 255, 0.50),
      inset -25px -34px 48px rgba(112, 105, 152, 0.16),
      0 36px 68px rgba(73, 78, 107, 0.14);

    transform: translate(-50%, -50%);
  }


  .history-object__disc::before {
    content: "";

    width: 69%;
    height: 33%;

    position: absolute;
    top: 7%;
    left: 12%;

    border-radius: 50%;

    background:
      radial-gradient(
        ellipse,
        rgba(255, 255, 255, 0.76),
        transparent 70%
      );

    filter: blur(7px);
    transform: rotate(-23deg);
  }


  .history-object__ring {
    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    border: 1px solid rgba(54, 64, 91, 0.18);
    border-radius: 50%;

    box-shadow:
      0 0 18px rgba(255, 255, 255, 0.48),
      inset 0 0 18px rgba(255, 255, 255, 0.21);
  }


  .history-object__ring--outer {
    width: 91%;
    height: 36%;

    transform:
      translate(-50%, -50%)
      rotate(-17deg);
  }


  .history-object__ring--inner {
    width: 43%;
    height: 91%;

    transform:
      translate(-50%, -50%)
      rotate(26deg);
  }


  .history-object__hand {
    height: 1px;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    background:
      linear-gradient(
        to right,
        rgba(46, 53, 72, 0.68),
        rgba(46, 53, 72, 0.15)
      );

    transform-origin: left center;
  }


  .history-object__hand--long {
    width: 23%;

    transform:
      translateY(-50%)
      rotate(-44deg);
  }


  .history-object__hand--short {
    width: 15%;

    transform:
      translateY(-50%)
      rotate(29deg);
  }


  .history-object__centre {
    width: 13px;
    aspect-ratio: 1;

    position: absolute;
    top: 50%;
    left: 50%;

    display: block;

    background:
      radial-gradient(
        circle at 31% 26%,
        white,
        rgba(213, 210, 222, 0.82) 43%,
        rgba(78, 81, 103, 0.48)
      );

    border: 1px solid rgba(255, 255, 255, 0.90);
    border-radius: 50%;

    box-shadow:
      0 7px 16px rgba(55, 61, 84, 0.20),
      inset 0 1px 0 white;

    transform: translate(-50%, -50%);
  }


  .history-object__node {
    width: 12px;
    aspect-ratio: 1;

    position: absolute;

    display: block;

    background:
      radial-gradient(
        circle at 32% 26%,
        white,
        rgba(228, 205, 187, 0.76) 42%,
        rgba(128, 103, 94, 0.38)
      );

    border: 1px solid rgba(255, 255, 255, 0.88);
    border-radius: 50%;

    box-shadow: 0 8px 16px rgba(63, 61, 82, 0.17);
  }


  .history-object__node--one {
    top: 25%;
    right: 7%;
  }


  .history-object__node--two {
    width: 9px;

    bottom: 18%;
    left: 16%;
  }


  /* ---------------------------------- */
  /* CARTOGRAPHIC DETAILS               */
  /* ---------------------------------- */

  .contour-lines {
    width: min(44vw, 590px);

    position: absolute;
    z-index: -2;

    color: rgba(67, 71, 94, 0.17);

    opacity: 0.34;
    pointer-events: none;
  }


  .contour-lines path {
    stroke: currentColor;
    stroke-width: 1.15;
    vector-effect: non-scaling-stroke;
  }


  .contour-lines--left {
    left: -16%;
    bottom: -28%;

    transform: rotate(8deg);
  }


  .contour-lines--right {
    top: -30%;
    right: -15%;

    transform:
      rotate(188deg)
      scale(0.84);
  }


  /* ---------------------------------- */
  /* EDGE DETAILS                       */
  /* ---------------------------------- */

  .edge-mark {
    width: 44px;
    height: 44px;

    position: absolute;
    z-index: 4;

    opacity: 0.29;
    pointer-events: none;
  }


  .edge-mark::before,
  .edge-mark::after {
    content: "";

    position: absolute;

    background: rgba(62, 70, 94, 0.28);
    border-radius: 999px;
  }


  .edge-mark::before {
    width: 44px;
    height: 1px;
  }


  .edge-mark::after {
    width: 1px;
    height: 44px;
  }


  .edge-mark--top-left {
    top: 24px;
    left: 24px;
  }


  .edge-mark--top-right {
    top: 24px;
    right: 24px;

    transform: rotate(90deg);
  }


  .edge-mark--bottom-left {
    bottom: 24px;
    left: 24px;

    transform: rotate(-90deg);
  }


  .edge-mark--bottom-right {
    right: 24px;
    bottom: 24px;

    transform: rotate(180deg);
  }


  /* ---------------------------------- */
  /* MOTION                             */
  /* ---------------------------------- */

  @keyframes content-enter {
    from {
      opacity: 0;
      transform: translateY(17px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  @keyframes object-float {
    0%,
    100% {
      transform:
        translate(-50%, calc(-50% - 5px))
        rotate(-0.5deg);
    }

    50% {
      transform:
        translate(-50%, calc(-50% + 7px))
        rotate(0.7deg);
    }
  }


  /* ---------------------------------- */
  /* MOBILE                             */
  /* ---------------------------------- */

  @media (max-width: 650px) {
    .placeholder-page {
      min-height: calc(100svh - 93px);

      padding:
        82px
        20px
        72px;

      border-radius: 30px;
    }

    .eyebrow {
      margin-bottom: 22px;

      font-size: 9px;
      letter-spacing: 0.13em;
    }

    h1 {
      max-width: 100%;
      
      font-size: clamp(42px, 14vw, 72px);
      line-height: 0.96;
      letter-spacing: 0.035em;
    }

    .message {
      max-width: 340px;

      margin-top: 25px;

      font-size: 16px;
    }

    .history-object {
      width: min(126vw, 520px);

      top: 44%;

      opacity: 0.54;
    }

    .contour-lines {
      width: 94vw;
    }

    .contour-lines--left {
      left: -52%;
      bottom: -9%;
    }

    .contour-lines--right {
      top: -9%;
      right: -50%;
    }

    .edge-mark {
      width: 30px;
      height: 30px;
    }

    .edge-mark::before {
      width: 30px;
    }

    .edge-mark::after {
      height: 30px;
    }

    .edge-mark--top-left,
    .edge-mark--top-right {
      top: 17px;
    }

    .edge-mark--bottom-left,
    .edge-mark--bottom-right {
      bottom: 17px;
    }

    .edge-mark--top-left,
    .edge-mark--bottom-left {
      left: 17px;
    }

    .edge-mark--top-right,
    .edge-mark--bottom-right {
      right: 17px;
    }
  }


  @supports not (
    (backdrop-filter: blur(1px))
    or
    (-webkit-backdrop-filter: blur(1px))
  ) {
    .placeholder-page,
    .eyebrow {
      background-color: rgba(250, 249, 248, 0.94);
    }
  }
</style>