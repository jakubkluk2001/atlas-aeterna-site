---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="History | Atlas Aeterna">

  <section class="placeholder-page">

    <p class="eyebrow">
      Atlas Aeterna
    </p>

    <h1>History</h1>

    <p class="message">
      This part of Atlas Aeterna is still in development.
    </p>

  </section>

</BaseLayout>


<style>

  .placeholder-page {
    padding: 80px 0;
  }


  .eyebrow {
    margin: 0 0 16px;

    color: #77777c;

    font-size: 12px;

    letter-spacing: 0.16em;
    text-transform: uppercase;
  }


  h1 {
    margin-bottom: 24px;

    font-size: clamp(48px, 7vw, 82px);

    line-height: 1.05;
  }


  .message {
    max-width: 620px;

    margin: 0;

    color: #6e6e73;

    font-size: 18px;

    line-height: 1.8;
  }


  @media (max-width: 600px) {

    .placeholder-page {
      padding: 50px 0;
    }


    h1 {
      font-size: 44px;
    }


    .message {
      font-size: 16px;
    }

  }

</style>