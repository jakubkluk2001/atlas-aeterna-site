---
const { title = "Atlas Aeterna" } = Astro.props;

const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") {
    return pathname === "/";
  }

  return pathname === path || pathname.startsWith(`${path}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="stylesheet"
      href="https://use.typekit.net/sng8bvc.css"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <title>{title}</title>
  </head>

  <body>

    <header class="site-header">

      <nav
        class="site-nav"
        aria-label="Primary navigation"
      >

        <a
          class="site-brand"
          href="/"
          aria-current={isActive("/") ? "page" : undefined}
        >
          Atlas Aeterna
        </a>


        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-controls="primary-navigation"
          aria-expanded="false"
        >
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>


        <div
          class="nav-links"
          id="primary-navigation"
        >

          <a
            class:list={{ active: isActive("/history") }}
            href="/history"
            aria-current={isActive("/history") ? "page" : undefined}
          >
            History
          </a>

          <a
            class:list={{ active: isActive("/geography") }}
            href="/geography"
            aria-current={isActive("/geography") ? "page" : undefined}
          >
            Geography
          </a>

          <a
            class:list={{ active: isActive("/mysteries") }}
            href="/mysteries"
            aria-current={isActive("/mysteries") ? "page" : undefined}
          >
            Mysteries
          </a>

          <a
            class:list={{ active: isActive("/about") }}
            href="/about"
            aria-current={isActive("/about") ? "page" : undefined}
          >
            About
          </a>

        </div>

      </nav>

    </header>


    <main>
      <slot />
    </main>


    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");

      if (
        menuToggle instanceof HTMLButtonElement &&
        navLinks instanceof HTMLElement
      ) {

        const closeMenu = () => {
          navLinks.classList.remove("is-open");

          menuToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          menuToggle.setAttribute(
            "aria-label",
            "Open navigation menu"
          );
        };


        menuToggle.addEventListener("click", () => {

          const isOpen =
            menuToggle.getAttribute("aria-expanded") === "true";

          navLinks.classList.toggle(
            "is-open",
            !isOpen
          );

          menuToggle.setAttribute(
            "aria-expanded",
            String(!isOpen)
          );

          menuToggle.setAttribute(
            "aria-label",
            isOpen
              ? "Open navigation menu"
              : "Close navigation menu"
          );

        });


        navLinks
          .querySelectorAll("a")
          .forEach((link) => {

            link.addEventListener(
              "click",
              closeMenu
            );

          });


        document.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Escape") {
              closeMenu();
            }

          }
        );


        window.addEventListener(
          "resize",
          () => {

            if (window.innerWidth > 750) {
              closeMenu();
            }

          }
        );

      }
    </script>

  </body>
</html>


<style is:global>

  /* ---------------------------------- */
  /* COLOURS                            */
  /* ---------------------------------- */

  :root {
    --background: #f5f7fb;
    --surface: #ffffff;

    --text: #171719;
    --text-secondary: #6e6e73;

    --border: rgba(20, 20, 25, 0.08);

    --blue: #6b9dfc;
    --purple: #a687f4;
    --peach: #f2b98d;
  }


  /* ---------------------------------- */
  /* GENERAL                            */
  /* ---------------------------------- */

  * {
    box-sizing: border-box;
  }


  html {
    min-height: 100%;

    background: var(--background);

    scroll-behavior: smooth;
  }


  body {
    min-height: 100vh;

    margin: 0;

    overflow-x: hidden;

    font-family: trajan-pro-3, serif;

    color: var(--text);

    background:
      radial-gradient(
        circle at 15% 15%,
        rgba(107, 157, 252, 0.16),
        transparent 27%
      ),
      radial-gradient(
        circle at 85% 20%,
        rgba(166, 135, 244, 0.14),
        transparent 28%
      ),
      radial-gradient(
        circle at 50% 90%,
        rgba(242, 185, 141, 0.13),
        transparent 32%
      ),
      linear-gradient(
        180deg,
        #fafbff 0%,
        #f5f7fb 52%,
        #f7f7fa 100%
      );

    background-attachment: fixed;

    -webkit-font-smoothing: antialiased;
  }


  ::selection {
    color: #111;

    background: rgba(107, 157, 252, 0.35);
  }


  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }


  a:focus-visible,
  button:focus-visible {
    outline: 2px solid rgba(77, 126, 232, 0.7);
    outline-offset: 4px;
  }


  /* ---------------------------------- */
  /* NAVIGATION                         */
  /* ---------------------------------- */

  .site-header {
    width: 100%;

    position: sticky;
    top: 0;

    z-index: 100;

    background: rgba(255, 255, 255, 0.72);

    border-bottom: 1px solid rgba(20, 20, 25, 0.07);

    box-shadow:
      0 1px 2px rgba(20, 20, 25, 0.02);

    backdrop-filter:
      blur(22px)
      saturate(180%);

    -webkit-backdrop-filter:
      blur(22px)
      saturate(180%);
  }


  .site-nav {
    width: 100%;
    max-width: 1280px;

    margin: 0 auto;
    padding: 16px 28px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 40px;
  }


  .site-nav a {
    text-decoration: none;
    white-space: nowrap;
  }


  /* SITE NAME */

  .site-brand {
    color: var(--text);

    font-size: 19px;
    font-weight: 600;

    letter-spacing: 0.08em;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }


  .site-brand:hover {
    opacity: 0.7;

    transform: translateY(-1px);
  }


  /* DESKTOP LINKS */

  .nav-links {
    display: flex;
    align-items: center;

    gap: 6px;
  }


  .nav-links a {
    padding: 10px 14px;

    color: var(--text-secondary);

    border-radius: 999px;

    font-size: 14px;

    transition:
      color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }


  .nav-links a:hover {
    color: var(--text);

    background: rgba(20, 20, 25, 0.045);

    transform: translateY(-1px);
  }


  .nav-links a.active {
    color: var(--text);

    background: rgba(20, 20, 25, 0.065);
  }


  /* ---------------------------------- */
  /* MOBILE MENU BUTTON                 */
  /* ---------------------------------- */

  .menu-toggle {
    width: 42px;
    height: 42px;

    padding: 0;

    align-items: center;
    justify-content: center;

    color: var(--text);

    background: rgba(20, 20, 25, 0.045);

    border: 1px solid rgba(20, 20, 25, 0.06);
    border-radius: 50%;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }


  .menu-toggle:hover {
    background: rgba(20, 20, 25, 0.075);

    transform: scale(1.03);
  }


  .menu-icon {
    width: 19px;

    display: flex;
    flex-direction: column;

    gap: 5px;
  }


  .menu-icon span {
    width: 100%;
    height: 1.5px;

    display: block;

    background: currentColor;

    border-radius: 10px;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }


  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(1) {
    transform:
      translateY(6.5px)
      rotate(45deg);
  }


  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(2) {
    opacity: 0;
  }


  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(3) {
    transform:
      translateY(-6.5px)
      rotate(-45deg);
  }


  /* ---------------------------------- */
  /* MAIN CONTENT                       */
  /* ---------------------------------- */

  main {
    width: 100%;
    max-width: 1280px;

    margin: 0 auto;

    padding: 36px 28px 80px;
  }


  h1 {
    margin-top: 0;

    color: var(--text);

    font-weight: 400;
  }


  p {
    color: var(--text-secondary);

    line-height: 1.7;
  }


  button,
  input,
  textarea,
  select {
    font: inherit;
  }


  /* ---------------------------------- */
  /* DESKTOP                            */
  /* ---------------------------------- */

  @media (min-width: 751px) {

    .site-nav .menu-toggle {
      display: none;
    }

  }


  /* ---------------------------------- */
  /* MOBILE                             */
  /* ---------------------------------- */

  @media (max-width: 750px) {

    .site-nav {
      padding: 14px 18px;

      gap: 0;

      flex-wrap: wrap;
    }


    .site-brand {
      font-size: 16px;
    }


    .menu-toggle {
      display: flex;
    }


    .nav-links {
      display: none;

      width: 100%;
      flex-basis: 100%;

      padding-top: 12px;

      flex-direction: column;
      align-items: stretch;

      gap: 2px;
    }


    .nav-links.is-open {
      display: flex;
    }


    .nav-links a {
      width: 100%;

      padding: 14px 8px;

      border-radius: 10px;

      font-size: 14px;
    }


    main {
      width: 100%;

      padding: 22px 16px 60px;
    }

  }


  /* ---------------------------------- */
  /* REDUCED MOTION                     */
  /* ---------------------------------- */

  @media (prefers-reduced-motion: reduce) {

    html {
      scroll-behavior: auto;
    }


    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;

      transition-duration: 0.01ms !important;
    }

  }

</style>