---
const { title = "Atlas Aeterna" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="stylesheet" href="https://use.typekit.net/sng8bvc.css">

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
  </head>

  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/page2">Page 2</a>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: trajan-pro-3, serif;
    background: #111;
    color: #fff;
  }

  nav {
    max-width: 800px;
    margin: 0 auto;
    padding: 30px 30px 0;
  }

  nav a {
    color: #fff;
    text-decoration: none;
    margin-right: 30px;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 30px;
  }

  h1 {
    font-size: 64px;
    margin-bottom: 20px;
  }

  p {
    font-size: 20px;
    line-height: 1.6;
  }

  .muted {
    color: #999;
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }
</style>