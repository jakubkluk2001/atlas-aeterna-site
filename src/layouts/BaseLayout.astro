---
const { title = "Atlas Aeterna" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="stylesheet"
      href="https://use.typekit.net/sng8bvc.css"
    />

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <title>{title}</title>
  </head>

  <body>

    <header class="site-header">

      <nav
        class="site-nav"
        aria-label="Primary navigation"
      >

        <a
          class="site-brand"
          href="/"
        >
          Atlas Aeterna
        </a>


        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-controls="primary-navigation"
          aria-expanded="false"
        >
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>


        <div
          class="nav-links"
          id="primary-navigation"
        >
          <a href="/history">History</a>
          <a href="/geography">Geography</a>
          <a href="/mysteries">Mysteries</a>
          <a href="/about">About</a>
        </div>

      </nav>

    </header>


    <main>
      <slot />
    </main>


    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const navLinks = document.querySelector(".nav-links");

      if (
        menuToggle instanceof HTMLButtonElement &&
        navLinks instanceof HTMLElement
      ) {

        const closeMenu = () => {
          navLinks.classList.remove("is-open");

          menuToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          menuToggle.setAttribute(
            "aria-label",
            "Open navigation menu"
          );
        };


        menuToggle.addEventListener("click", () => {

          const isOpen =
            menuToggle.getAttribute("aria-expanded") === "true";

          navLinks.classList.toggle("is-open", !isOpen);

          menuToggle.setAttribute(
            "aria-expanded",
            String(!isOpen)
          );

          menuToggle.setAttribute(
            "aria-label",
            isOpen
              ? "Open navigation menu"
              : "Close navigation menu"
          );

        });


        navLinks
          .querySelectorAll("a")
          .forEach((link) => {

            link.addEventListener(
              "click",
              closeMenu
            );

          });


        document.addEventListener(
          "keydown",
          (event) => {

            if (event.key === "Escape") {
              closeMenu();
            }

          }
        );


        window.addEventListener(
          "resize",
          () => {

            if (window.innerWidth > 750) {
              closeMenu();
            }

          }
        );

      }
    </script>

  </body>
</html>


<style is:global>

  /* ------------------------- */
  /* GENERAL                   */
  /* ------------------------- */

  * {
    box-sizing: border-box;
  }


  body {
    margin: 0;

    font-family: trajan-pro-3, serif;

    background: #111;
    color: #fff;
  }


  /* ------------------------- */
  /* NAVIGATION                */
  /* ------------------------- */

  .site-header {
    width: 100%;

    border-bottom: 1px solid #222;
  }


  .site-nav {
    max-width: 1200px;

    margin: 0 auto;
    padding: 24px 30px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 40px;
  }


  .site-nav a {
    text-decoration: none;
    white-space: nowrap;
  }


  /* SITE NAME */

  .site-brand {
    color: #fff;

    font-size: 20px;
    font-weight: 600;

    letter-spacing: 0.08em;
  }


  /* DESKTOP LINKS */

  .nav-links {
    display: flex;
    align-items: center;

    gap: 35px;
  }


  .nav-links a {
    color: #999;

    transition: color 0.2s ease;
  }


  .nav-links a:hover {
    color: #fff;
  }


  /* MOBILE MENU BUTTON */

  .menu-toggle {
    display: none;

    width: 44px;
    height: 44px;

    padding: 0;

    align-items: center;
    justify-content: center;

    border: 0;

    background: transparent;
    color: #fff;

    cursor: pointer;
  }


  .menu-icon {
    width: 22px;

    display: flex;
    flex-direction: column;

    gap: 5px;
  }


  .menu-icon span {
    width: 100%;
    height: 1px;

    display: block;

    background: currentColor;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }


  /* TURN HAMBURGER INTO X */

  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(1) {
    transform:
      translateY(6px)
      rotate(45deg);
  }


  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(2) {
    opacity: 0;
  }


  .menu-toggle[aria-expanded="true"]
  .menu-icon span:nth-child(3) {
    transform:
      translateY(-6px)
      rotate(-45deg);
  }


  /* ------------------------- */
  /* MAIN CONTENT              */
  /* ------------------------- */

  main {
    max-width: 1000px;

    margin: 0 auto;
    padding: 80px 30px;
  }


  h1 {
    margin-top: 0;
    margin-bottom: 20px;

    font-size: 64px;
  }


  p {
    font-size: 20px;

    line-height: 1.6;
  }


  .muted {
    color: #999;
  }


  button,
  input,
  textarea,
  select {
    font: inherit;
  }


  /* ------------------------- */
  /* MOBILE                    */
  /* ------------------------- */

  @media (max-width: 750px) {

    .site-nav {
      padding: 18px 20px;

      gap: 0;

      flex-wrap: wrap;
    }


    .site-brand {
      font-size: 16px;
    }


    /* SHOW HAMBURGER */

    .menu-toggle {
      display: flex;
    }


    /* HIDE LINKS INITIALLY */

    .nav-links {
      display: none;

      width: 100%;
      flex-basis: 100%;

      padding-top: 18px;

      flex-direction: column;
      align-items: flex-start;

      gap: 0;
    }


    /* SHOW LINKS WHEN MENU OPENS */

    .nav-links.is-open {
      display: flex;
    }


    .nav-links a {
      width: 100%;

      padding: 15px 0;

      font-size: 16px;

      border-top: 1px solid #222;
    }


    main {
      padding: 50px 20px;
    }


    h1 {
      font-size: 42px;
    }

  }

  /* Make sure mobile menu button stays hidden on desktop */

  @media (min-width: 751px) {

    .site-nav .menu-toggle {
      display: none;
    }

  }
  
</style>